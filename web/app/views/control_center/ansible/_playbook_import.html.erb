<div data-ansible-playbook-import-target="dropOverlay" aria-hidden="true"
     class="pointer-events-none fixed inset-0 z-[60] hidden bg-zinc-950/60 p-5 backdrop-blur-sm">
  <div class="flex h-full items-center justify-center rounded-2xl border-2 border-dashed border-white/70">
    <div class="rounded-xl bg-zinc-950/80 px-10 py-8 text-center text-white shadow-2xl">
      <p class="text-lg font-semibold">Drop YAML playbooks to import</p>
      <p class="mt-1 text-sm text-zinc-300">Files are validated and processed in drop order.</p>
    </div>
  </div>
</div>

<dialog data-ansible-playbook-import-target="dialog"
        data-action="cancel->ansible-playbook-import#preventClose"
        class="fixed inset-0 z-[70] m-auto w-[min(44rem,calc(100vw-2rem))] overflow-hidden rounded-xl border border-zinc-200 bg-white p-0 text-zinc-900 shadow-2xl backdrop:bg-zinc-950/60 dark:border-zinc-700 dark:bg-[#111315] dark:text-zinc-100">
  <div class="border-b border-zinc-200 px-5 py-4 dark:border-zinc-800">
    <h2 class="text-base font-semibold">Import YAML playbooks</h2>
    <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Files run sequentially; one failure does not stop the remaining batch.</p>
  </div>
  <div class="max-h-[50vh] overflow-y-auto px-5 py-4">
    <div data-ansible-playbook-import-target="rows" class="space-y-2"></div>
    <p data-ansible-playbook-import-target="summary" class="mt-4 text-sm font-medium" aria-live="polite"></p>

    <div data-ansible-playbook-import-target="conflictPanel"
         data-action="keydown->ansible-playbook-import#trapConflictFocus"
         class="mt-4 hidden rounded-lg border border-amber-300 bg-amber-50 p-4 dark:border-amber-900 dark:bg-amber-950/30">
      <h3 class="text-sm font-semibold">Playbook name already exists</h3>
      <p class="mt-1 text-sm"><span data-ansible-playbook-import-target="conflictFile"></span> maps to <strong data-ansible-playbook-import-target="conflictName"></strong>.</p>
      <div class="mt-3 flex flex-wrap gap-2">
        <button type="button" data-decision="update" data-action="ansible-playbook-import#chooseConflict" class="rounded bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white dark:bg-white dark:text-zinc-900">Update</button>
        <button type="button" data-decision="update_all" data-action="ansible-playbook-import#chooseConflict" class="rounded border border-zinc-300 px-3 py-1.5 text-sm font-medium dark:border-zinc-700">Update all</button>
        <button type="button" data-decision="skip" data-action="ansible-playbook-import#chooseConflict" class="rounded border border-zinc-300 px-3 py-1.5 text-sm font-medium dark:border-zinc-700">Skip</button>
        <button type="button" data-decision="skip_all" data-action="ansible-playbook-import#chooseConflict" class="rounded border border-zinc-300 px-3 py-1.5 text-sm font-medium dark:border-zinc-700">Skip all</button>
      </div>
    </div>
  </div>
  <div class="flex justify-end border-t border-zinc-200 px-5 py-3 dark:border-zinc-800">
    <button type="button" disabled data-ansible-playbook-import-target="close" data-action="ansible-playbook-import#close"
            class="rounded-md border border-zinc-300 px-3 py-1.5 text-sm font-medium disabled:opacity-40 dark:border-zinc-700">Close</button>
  </div>
</dialog>
