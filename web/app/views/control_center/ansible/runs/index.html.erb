<% content_for :title, "hunter — Ansible runs" %>
<% content_for :container, "mx-auto max-w-screen-2xl px-6 py-10" %>

<%= render "control_center/ansible/header" %>

<section class="mt-6">
  <div class="flex flex-wrap items-end justify-between gap-3">
    <div>
      <h2 class="text-lg font-semibold">Run history</h2>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Immutable launches and their isolated executor progress, newest first.</p>
    </div>
    <p data-executor-guidance class="rounded-md border px-3 py-2 text-xs <%= @ansible_executor_configured ?
      'border-emerald-300 text-emerald-700 dark:border-emerald-900 dark:text-emerald-300' :
      'border-amber-300 text-amber-700 dark:border-amber-900 dark:text-amber-300' %>">
      <%= @ansible_executor_configured ? "Ansible executor identity configured" : "No Ansible executor identity is configured; queued runs will wait until one is available." %>
    </p>
  </div>

  <div data-run-history class="mt-4 overflow-hidden rounded-lg border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-[#111315]">
    <% if @run_groups.empty? %>
      <p class="px-5 py-14 text-center text-sm text-zinc-500">No runs yet. Launch a saved playbook to create history.</p>
    <% else %>
      <div class="divide-y divide-zinc-100 dark:divide-zinc-800">
        <% @run_groups.each do |group| %>
          <% run = group.runs.first %>
          <%= link_to control_center_ansible_run_path(group), class: "grid gap-2 px-5 py-4 hover:bg-zinc-50 sm:grid-cols-[1fr_auto_auto] sm:items-center dark:hover:bg-zinc-900" do %>
            <span>
              <span class="block text-sm font-semibold"><%= run&.playbook_name || "Ansible run" %></span>
              <span class="mt-0.5 block text-xs text-zinc-500"><%= run&.inventory_name || group.launch_snapshot.dig("inventory", "name") %> · <%= time_ago_in_words(group.created_at) %> ago</span>
            </span>
            <span class="text-xs text-zinc-500"><%= group.runs.size %> playbook</span>
            <span class="rounded-full border border-zinc-300 px-2 py-1 text-xs font-medium dark:border-zinc-700"><%= group.status %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  </div>
</section>
