<%# web/app/views/cves/overview/_row.html.erb — collection partial, local: cve %>
<tr data-controller="rowlink"
    data-rowlink-url-value="<%= cves_detail_path(cve.id) %>"
    data-rowlink-frame-value="cve_panel"
    data-action="click->rowlink#open"
    class="cursor-pointer border-b border-zinc-100 last:border-0 hover:bg-zinc-50 dark:border-zinc-800/60 dark:hover:bg-white/5">
  <td class="px-4 py-3 font-mono text-zinc-900 dark:text-zinc-100"><%= cve.id %></td>
  <td class="px-4 py-3 text-zinc-700 dark:text-zinc-300"><%= truncate(cve.summary.presence || "—", length: 90) %></td>
  <td class="px-4 py-3 text-zinc-600 dark:text-zinc-400"><%= cve.ecosystems.join(", ").presence || "—" %></td>
  <td class="px-4 py-3"><%= render "cves/overview/fix_badge", has_fix: cve.has_fix %></td>
  <td class="px-4 py-3 font-mono text-xs text-zinc-500 dark:text-zinc-400"><%= cve_cvss_score(cve.severity) || "—" %></td>
  <td class="px-4 py-3 text-zinc-500 dark:text-zinc-400"><%= cve_short_date(cve.modified) %></td>
</tr>
