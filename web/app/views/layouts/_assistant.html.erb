<div data-controller="assistant"
     data-assistant-openai-asset-value="<%= asset_path('assistant/openai.svg') %>"
     data-assistant-anthropic-asset-value="<%= asset_path('assistant/anthropic.svg') %>"
     data-action="keydown@window->assistant#handleKeydown">
  <button type="button"
          data-assistant-target="bubble"
          data-action="assistant#open"
          aria-label="Open Hunter assistant"
          aria-expanded="false"
          aria-controls="hunter-assistant-panel"
          class="fixed bottom-4 right-4 z-[70] grid h-14 w-14 place-items-center rounded-2xl bg-zinc-950 text-zinc-100 shadow-[0_16px_40px_-12px_rgba(0,0,0,0.65)] ring-1 ring-white/15 transition duration-200 hover:-translate-y-0.5 hover:bg-zinc-800 hover:shadow-[0_20px_48px_-12px_rgba(0,0,0,0.6)] focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 dark:bg-zinc-900">
    <svg aria-hidden="true" viewBox="0 0 24 24" class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="1.8">
      <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 18.5 4 20l1.25-3.75A8 8 0 1 1 7.5 18.5Z" />
      <path stroke-linecap="round" d="M8 10.5h8M8 14h5" />
    </svg>
  </button>

  <section id="hunter-assistant-panel"
           data-assistant-target="panel"
           role="dialog"
           aria-modal="true"
           aria-labelledby="hunter-assistant-title"
           hidden
           class="assistant-panel fixed inset-0 z-[75] flex h-dvh w-full flex-col overflow-hidden border border-zinc-400 bg-zinc-50 shadow-2xl sm:inset-auto sm:bottom-4 sm:right-4 sm:rounded-xl sm:ring-1 sm:ring-zinc-950/20 dark:border-zinc-600 dark:bg-[#0a0a0a] dark:ring-white/15">
    <button type="button"
            data-assistant-target="resizeHandle"
            data-action="pointerdown->assistant#startResize keydown->assistant#resizeWithKeyboard"
            aria-label="Resize Hunter assistant"
            aria-describedby="hunter-assistant-resize-help"
            aria-keyshortcuts="ArrowLeft ArrowRight ArrowUp ArrowDown"
            title="Resize chat"
            class="absolute left-1.5 top-2 z-20 hidden h-8 w-28 touch-none cursor-nwse-resize items-center justify-center gap-1.5 rounded-md border border-zinc-300 bg-zinc-100 px-2 text-zinc-600 shadow-sm transition hover:border-zinc-500 hover:bg-white hover:text-zinc-950 focus:outline-none focus:ring-2 focus:ring-zinc-500 sm:flex dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300 dark:hover:border-zinc-500 dark:hover:bg-zinc-800 dark:hover:text-white">
      <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8">
        <path stroke-linecap="round" d="M5 15v4h4M5 19l6-6M5 9V5h4M5 5l6 6" />
      </svg>
      <span data-assistant-resize-label class="text-[10px] font-semibold">Drag to resize</span>
    </button>
    <span id="hunter-assistant-resize-help" class="sr-only">Use the arrow keys to resize. Hold Shift for larger steps.</span>
    <span id="hunter-assistant-resize-status" data-assistant-target="resizeStatus" role="status" aria-live="polite" aria-atomic="true" class="sr-only"></span>

    <header class="flex min-h-14 items-center justify-between gap-3 border-b border-zinc-300 bg-white/90 py-2.5 pl-3 pr-2.5 backdrop-blur dark:border-zinc-700 dark:bg-[#0a0a0a]/90 sm:pl-32 sm:pr-3">
      <div class="flex min-w-0 items-center gap-2.5">
        <span class="grid h-8 w-8 shrink-0 place-items-center rounded-lg bg-zinc-950 text-white ring-1 ring-white/15 dark:bg-zinc-100 dark:text-zinc-950">
          <svg aria-hidden="true" viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="1.8">
            <path stroke-linecap="round" stroke-linejoin="round" d="M7.5 18.5 4 20l1.25-3.75A8 8 0 1 1 7.5 18.5Z" />
            <path stroke-linecap="round" d="M8 10.5h8M8 14h5" />
          </svg>
        </span>
        <div class="min-w-0">
          <h2 id="hunter-assistant-title" class="truncate text-sm font-semibold tracking-tight text-zinc-950 dark:text-zinc-100">Hunter assistant</h2>
          <p class="truncate text-[11px] text-zinc-500 dark:text-zinc-500">Broad Hunter operations through MCP · unrestricted Whiterabbit jobs</p>
        </div>
      </div>
      <button type="button" data-action="assistant#close" data-assistant-initial-focus aria-label="Close Hunter assistant"
              class="grid h-10 w-10 shrink-0 place-items-center rounded-lg text-zinc-500 transition hover:bg-zinc-100 hover:text-zinc-950 focus:outline-none focus:ring-2 focus:ring-zinc-500 dark:hover:bg-white/5 dark:hover:text-zinc-100">
        <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="m6 6 12 12M18 6 6 18" /></svg>
      </button>
    </header>

    <details data-assistant-target="capabilityDisclosure"
             class="group border-b border-zinc-200 bg-zinc-100/70 dark:border-white/10 dark:bg-zinc-950">
      <summary class="flex cursor-pointer list-none items-center justify-between gap-3 px-4 py-2 text-[11px] font-medium text-zinc-600 transition hover:bg-zinc-100 hover:text-zinc-950 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-zinc-500 dark:text-zinc-500 dark:hover:bg-white/[0.03] dark:hover:text-zinc-200 [&::-webkit-details-marker]:hidden">
        <span class="flex items-center gap-2">
          <span class="h-1.5 w-1.5 rounded-full bg-zinc-700 dark:bg-zinc-300"></span>
          Data access &amp; actions
        </span>
        <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.8">
          <path stroke-linecap="round" stroke-linejoin="round" d="m6 8 4 4 4-4" />
        </svg>
      </summary>
      <p id="hunter-assistant-capability-disclosure"
         class="border-t border-zinc-200 bg-white px-4 py-3 text-[11px] leading-5 text-zinc-600 dark:border-white/10 dark:bg-[#0d0d0e] dark:text-zinc-400">
        The assistant has administrator-equivalent operational access through the reviewed Hunter MCP catalog. It can create and edit Whiterabbit templates with any executable and submit them without another prompt. Those jobs can cause arbitrary network, filesystem, process, privilege, or destructive effects available to the Whiterabbit worker; they can also cause exfiltration of worker-accessible data. You are responsible for target authorization and requested effects. Hunter attributes and metadata-audits these actions, applies exact tools/scopes, budgets, and live gates, and exposes no dedicated Hunter secret-value or record-delete tool, no dedicated Hunter governance tool for administering users, tokens, providers, or Assistant security settings, and no generic MCP proxy. Disabling the assistant or the relevant template-write or job-submit gate prevents new actions, but does not erase saved templates or reverse completed external effects. You can directly rename, reorder, or delete your own conversation history; those actions are never available to the LLM.
      </p>
    </details>

    <div data-assistant-target="historyWorkspace" data-history-collapsed="false"
         class="assistant-workspace-grid grid min-h-0 flex-1">
      <aside id="hunter-assistant-history" data-assistant-target="historySidebar" aria-label="Assistant conversations"
             class="assistant-history-sidebar slim-scroll min-h-0 overflow-y-auto border-r border-white/10 bg-[#0a0a0a] p-2 text-zinc-100">
        <div class="flex items-center justify-between gap-1 px-1 pb-2 pt-1">
          <p data-history-expanded-only class="min-w-0 truncate px-1 text-[10px] font-semibold uppercase tracking-[0.16em] text-zinc-500">Conversations</p>
          <button type="button" data-assistant-target="historyToggle" data-action="assistant#toggleHistory"
                  aria-controls="hunter-assistant-history" aria-expanded="true" aria-label="Collapse conversation history"
                  class="grid h-8 min-w-8 shrink-0 place-items-center rounded-md text-zinc-400 transition hover:bg-white/10 hover:text-white focus:outline-none focus:ring-2 focus:ring-white">
            <svg aria-hidden="true" viewBox="0 0 20 20" class="assistant-history-toggle-icon h-4 w-4 transition-transform" fill="none" stroke="currentColor" stroke-width="1.8">
              <path stroke-linecap="round" stroke-linejoin="round" d="m12 5-5 5 5 5" />
            </svg>
            <span data-assistant-target="historyToggleLabel" class="sr-only">Collapse</span>
          </button>
        </div>
        <button type="button" data-action="assistant#showNewConversation" aria-label="New chat"
                class="flex w-full items-center justify-center gap-1.5 rounded-lg bg-white px-2 py-2.5 text-xs font-semibold text-zinc-950 shadow-sm ring-1 ring-zinc-300 transition hover:bg-zinc-200 focus:outline-none focus:ring-2 focus:ring-white focus:ring-offset-2 focus:ring-offset-[#0a0a0a]">
          <svg aria-hidden="true" viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" d="M10 4v12M4 10h12" /></svg>
          <span data-history-expanded-only>New chat</span>
        </button>
        <div data-assistant-target="conversationList" data-history-expanded-only class="mt-2 space-y-1.5"></div>
      </aside>

      <div class="assistant-chat-column flex min-h-0 min-w-0 flex-col bg-zinc-50 dark:bg-[#0d0d0e]">
        <p data-assistant-target="notice" role="alert" hidden
           class="border-b border-rose-200 bg-rose-50 px-3 py-2 text-xs font-medium leading-5 text-rose-800 dark:border-rose-500/20 dark:bg-rose-500/10 dark:text-rose-200"></p>
        <p data-assistant-target="status" role="status" aria-live="polite" hidden
           class="border-b border-amber-200 bg-amber-50 px-3 py-2 text-xs leading-5 text-amber-800 dark:border-amber-500/20 dark:bg-amber-500/10 dark:text-amber-200"></p>

        <div data-assistant-target="startScreen" class="slim-scroll min-h-0 flex-1 overflow-y-auto p-4 sm:p-6">
          <div class="mx-auto max-w-md">
            <span class="grid h-11 w-11 place-items-center rounded-xl border border-zinc-300 bg-white text-zinc-800 shadow-sm dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-200">
              <svg aria-hidden="true" viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.7"><path stroke-linecap="round" stroke-linejoin="round" d="M12 3v3m0 12v3M3 12h3m12 0h3M5.64 5.64l2.12 2.12m8.48 8.48 2.12 2.12m0-12.72-2.12 2.12M7.76 16.24l-2.12 2.12" /><circle cx="12" cy="12" r="4" /></svg>
            </span>
            <h3 class="mt-4 text-lg font-semibold tracking-tight text-zinc-950 dark:text-zinc-100">Start a conversation</h3>
            <p class="mt-1.5 text-sm leading-6 text-zinc-600 dark:text-zinc-400">Choose a subscription-backed provider. One click creates a conversation pinned to that provider, with Hunter features available only through the Hunter MCP gateway.</p>

            <div role="group" class="mt-6 grid grid-cols-2 gap-3" aria-label="Choose an assistant provider">
              <button type="button" data-assistant-target="providerButton" data-action="assistant#startConversation"
                      data-backend="codex" aria-label="Start an OpenAI conversation" title="Start an OpenAI conversation"
                      class="group flex min-h-28 flex-col items-center justify-center gap-3 rounded-xl border border-zinc-300 bg-white px-4 py-4 text-sm font-semibold text-zinc-900 shadow-sm transition hover:-translate-y-0.5 hover:border-zinc-500 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:border-zinc-500 dark:focus:ring-offset-[#0d0d0e]">
                <span class="grid h-12 w-12 place-items-center rounded-xl bg-zinc-950 shadow-sm ring-1 ring-zinc-800">
                  <%= image_tag "assistant/openai.svg", alt: "", aria: { hidden: true }, class: "h-8 w-8 object-contain" %>
                </span>
                <span data-provider-label>OpenAI</span>
                <span data-provider-loading hidden>Starting…</span>
              </button>
              <button type="button" data-assistant-target="providerButton" data-action="assistant#startConversation"
                      data-backend="claude_code" aria-label="Start an Anthropic conversation" title="Start an Anthropic conversation"
                      class="group flex min-h-28 flex-col items-center justify-center gap-3 rounded-xl border border-zinc-300 bg-white px-4 py-4 text-sm font-semibold text-zinc-900 shadow-sm transition hover:-translate-y-0.5 hover:border-zinc-500 hover:shadow-md focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:hover:border-zinc-500 dark:focus:ring-offset-[#0d0d0e]">
                <span class="grid h-12 w-12 place-items-center rounded-xl bg-zinc-950 shadow-sm ring-1 ring-zinc-800">
                  <%= image_tag "assistant/anthropic.svg", alt: "", aria: { hidden: true }, class: "h-7 w-9 object-contain" %>
                </span>
                <span data-provider-label>Anthropic</span>
                <span data-provider-loading hidden>Starting…</span>
              </button>
            </div>
            <p data-assistant-target="providerStatus" role="status" aria-live="polite" class="mt-4 rounded-xl border border-amber-200 bg-amber-50/80 p-3 text-xs leading-5 text-amber-900 dark:border-amber-400/20 dark:bg-amber-400/[0.08] dark:text-amber-200">
              Retention details load before conversation creation. Local deletion cannot erase provider or backup copies.
            </p>
          </div>
        </div>

        <div data-assistant-target="conversationScreen" hidden class="min-h-0 flex-1 flex flex-col">
          <div class="flex min-h-10 items-center justify-between gap-2 border-b border-zinc-200 bg-white px-3 py-2 dark:border-white/10 dark:bg-[#0d0d0e]">
            <p data-assistant-target="profileName" class="flex min-w-0 items-center gap-2 truncate text-[11px] font-medium text-zinc-500 dark:text-zinc-500"></p>
            <div class="flex items-center gap-2">
              <div role="group" aria-label="Chat text size" class="flex items-center rounded-md border border-zinc-300 bg-zinc-50 p-0.5 dark:border-zinc-700 dark:bg-zinc-900">
                <button type="button" data-assistant-target="fontDecrease" data-action="assistant#decreaseFontScale"
                        aria-label="Decrease chat text size"
                        class="grid h-6 w-6 place-items-center rounded text-[10px] font-semibold text-zinc-600 hover:bg-white hover:text-zinc-950 focus:outline-none focus:ring-2 focus:ring-zinc-500 disabled:cursor-not-allowed disabled:opacity-35 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-white">A−</button>
                <span data-assistant-target="fontScaleStatus" role="status" aria-live="polite" aria-atomic="true"
                      class="min-w-10 text-center text-[9px] font-semibold tabular-nums text-zinc-500">100%</span>
                <button type="button" data-assistant-target="fontIncrease" data-action="assistant#increaseFontScale"
                        aria-label="Increase chat text size"
                        class="grid h-6 w-6 place-items-center rounded text-xs font-semibold text-zinc-600 hover:bg-white hover:text-zinc-950 focus:outline-none focus:ring-2 focus:ring-zinc-500 disabled:cursor-not-allowed disabled:opacity-35 dark:text-zinc-300 dark:hover:bg-zinc-800 dark:hover:text-white">A+</button>
              </div>
              <button type="button" data-assistant-target="cancelButton" data-action="assistant#cancelTurn" hidden
                      class="rounded-md px-2 py-1 text-[11px] font-semibold text-amber-700 transition hover:bg-amber-50 hover:text-amber-800 focus:outline-none focus:ring-2 focus:ring-amber-500 dark:text-amber-300 dark:hover:bg-amber-400/10">Cancel turn</button>
              <button type="button" data-action="assistant#deleteConversation" aria-describedby="hunter-assistant-delete-consequence" class="rounded-md px-2 py-1 text-[11px] font-semibold text-rose-600 transition hover:bg-rose-50 hover:text-rose-700 focus:outline-none focus:ring-2 focus:ring-rose-500 dark:text-rose-400 dark:hover:bg-rose-400/10">Delete</button>
            </div>
          </div>
          <div data-assistant-target="messages" role="log" aria-live="polite" aria-label="Conversation messages"
               class="slim-scroll min-h-0 flex-1 space-y-4 overflow-y-auto border-y border-zinc-300 bg-zinc-100/70 p-3 sm:p-4 dark:border-zinc-700 dark:bg-[#101011]"></div>
          <details data-assistant-target="contextDisclosure"
                   class="group border-t border-zinc-200 bg-white dark:border-white/10 dark:bg-[#0d0d0e]">
            <summary class="flex cursor-pointer list-none items-center justify-between gap-2 px-3 py-2 text-[11px] font-semibold text-zinc-500 transition hover:bg-zinc-50 hover:text-zinc-950 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-zinc-500 dark:hover:bg-white/[0.03] dark:hover:text-zinc-200 [&::-webkit-details-marker]:hidden">
              <span class="flex items-center gap-1.5">
                <svg aria-hidden="true" viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" d="M10 4v12M4 10h12" /></svg>
                Add Hunter context
              </span>
              <svg aria-hidden="true" viewBox="0 0 20 20" class="h-4 w-4 transition group-open:rotate-180" fill="none" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="m6 8 4 4 4-4" />
              </svg>
            </summary>
            <section aria-label="Attach Hunter context" class="border-t border-zinc-200 bg-zinc-50 p-3 dark:border-white/10 dark:bg-zinc-950">
              <div class="grid grid-cols-[minmax(0,1fr)_auto] gap-2">
                <label class="sr-only" for="hunter-assistant-context-type">Context type</label>
                <select id="hunter-assistant-context-type" data-assistant-target="contextType"
                        class="col-span-2 rounded-lg border-zinc-300 bg-white px-2.5 py-2 text-xs focus:border-zinc-500 focus:ring-zinc-500 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100">
                  <option value="target">Target</option>
                  <option value="program">Program</option>
                  <option value="cve">CVE</option>
                  <option value="vulnerability">Vulnerability</option>
                  <option value="whiterabbit_template">Whiterabbit template</option>
                  <option value="ansible_playbook">Ansible playbook</option>
                </select>
                <label class="sr-only" for="hunter-assistant-context-query">Find context</label>
                <input id="hunter-assistant-context-query" data-assistant-target="contextQuery" type="search" maxlength="200"
                       class="min-w-0 rounded-lg border-zinc-300 bg-white px-2.5 py-2 text-xs focus:border-zinc-500 focus:ring-zinc-500 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100"
                       placeholder="Search Hunter records">
                <button type="button" data-action="assistant#findContexts"
                        class="rounded-lg border border-zinc-300 bg-white px-3 py-1 text-xs font-semibold text-zinc-700 transition hover:bg-zinc-100 focus:outline-none focus:ring-2 focus:ring-zinc-500 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-200 dark:hover:bg-zinc-800">Find</button>
              </div>
              <div data-assistant-target="contextResults" class="slim-scroll mt-2 max-h-32 space-y-1 overflow-y-auto"></div>
            </section>
          </details>
          <section data-assistant-target="disclosurePreview" aria-label="Selected context disclosure preview" hidden class="slim-scroll max-h-40 space-y-2 overflow-y-auto border-t border-zinc-200 bg-white p-3 dark:border-white/10 dark:bg-[#0d0d0e]"></section>
          <section data-assistant-target="drafts" aria-label="Generated draft cards" aria-live="polite" class="slim-scroll max-h-[45%] space-y-2 overflow-y-auto border-t border-zinc-200 bg-white px-3 py-2 empty:hidden dark:border-white/10 dark:bg-[#0d0d0e]"></section>
          <form data-action="submit->assistant#submitMessage" class="border-t border-zinc-200 bg-white p-3 dark:border-white/10 dark:bg-[#0a0a0a]">
            <div class="rounded-xl border border-zinc-400 bg-zinc-50 shadow-sm transition focus-within:border-zinc-600 focus-within:ring-2 focus-within:ring-zinc-500/20 dark:border-zinc-600 dark:bg-zinc-900 dark:focus-within:border-zinc-400">
              <label class="sr-only" for="hunter-assistant-message">Message</label>
              <textarea id="hunter-assistant-message" data-assistant-target="messageInput"
                        data-action="input->assistant#autosizeComposer keydown->assistant#handleComposerKeydown"
                        aria-describedby="hunter-assistant-composer-hint" rows="2" disabled
                        class="block max-h-40 min-h-16 w-full resize-none border-0 bg-transparent px-3 py-2.5 text-sm leading-6 text-zinc-900 placeholder:text-zinc-400 focus:ring-0 disabled:cursor-not-allowed disabled:opacity-50 dark:text-zinc-100 dark:placeholder:text-zinc-600"
                        placeholder="Ask Hunter about your workspace…"></textarea>
              <div class="flex items-center justify-between gap-3 border-t border-zinc-200/80 px-2.5 py-2 dark:border-white/10">
                <p id="hunter-assistant-composer-hint" class="truncate text-[10px] text-zinc-500">Enter to send · Shift+Enter for a new line</p>
                <button type="submit" data-assistant-target="sendButton" disabled
                        class="inline-flex shrink-0 items-center gap-1.5 rounded-lg bg-zinc-950 px-3 py-1.5 text-xs font-semibold text-white shadow-sm transition hover:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 disabled:cursor-not-allowed disabled:opacity-40 dark:bg-zinc-100 dark:text-zinc-950 dark:hover:bg-white dark:focus:ring-offset-zinc-900">
                  Send
                  <svg aria-hidden="true" viewBox="0 0 20 20" class="h-3.5 w-3.5" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="m5 10 9-6-3 12-2-4-4-2Z" /></svg>
                </button>
              </div>
            </div>
          </form>
        </div>
      </div>
    </div>
    <p id="hunter-assistant-delete-consequence" class="sr-only">Hunter will permanently delete this local conversation and its messages. Provider or backup copies may remain under their retention policies.</p>

  <div data-assistant-target="historyMenu" role="menu" aria-label="Conversation actions" hidden
       data-action="keydown->assistant#handleHistoryMenuKeydown"
       class="fixed z-[90] min-w-40 rounded-lg border border-zinc-300 bg-white p-1 shadow-xl dark:border-zinc-600 dark:bg-zinc-900">
    <button type="button" role="menuitem" data-assistant-target="historyMenuRename" data-action="assistant#beginRename"
            class="block w-full rounded-md px-3 py-2 text-left text-xs font-medium text-zinc-700 hover:bg-zinc-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-zinc-500 disabled:opacity-40 dark:text-zinc-200 dark:hover:bg-zinc-800">Rename</button>
    <button type="button" role="menuitem" data-assistant-target="historyMenuMoveUp" data-action="assistant#moveHistoryUp"
            class="block w-full rounded-md px-3 py-2 text-left text-xs font-medium text-zinc-700 hover:bg-zinc-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-zinc-500 disabled:opacity-40 dark:text-zinc-200 dark:hover:bg-zinc-800">Move up</button>
    <button type="button" role="menuitem" data-assistant-target="historyMenuMoveDown" data-action="assistant#moveHistoryDown"
            class="block w-full rounded-md px-3 py-2 text-left text-xs font-medium text-zinc-700 hover:bg-zinc-100 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-zinc-500 disabled:opacity-40 dark:text-zinc-200 dark:hover:bg-zinc-800">Move down</button>
    <div class="my-1 border-t border-zinc-200 dark:border-zinc-700"></div>
    <button type="button" role="menuitem" data-action="assistant#deleteHistoryConversation" aria-describedby="hunter-assistant-delete-consequence"
            class="block w-full rounded-md px-3 py-2 text-left text-xs font-semibold text-rose-600 hover:bg-rose-50 focus:outline-none focus:ring-2 focus:ring-inset focus:ring-rose-500 dark:text-rose-400 dark:hover:bg-rose-500/10">Delete</button>
  </div>

  <dialog data-assistant-target="renameDialog" aria-labelledby="hunter-assistant-rename-title"
          data-action="cancel->assistant#cancelRename"
          class="fixed inset-0 m-auto w-[min(28rem,calc(100vw-2rem))] rounded-xl border border-zinc-300 bg-white p-0 text-zinc-950 shadow-2xl backdrop:bg-black/60 dark:border-zinc-600 dark:bg-zinc-950 dark:text-zinc-100">
    <form data-action="submit->assistant#submitRename" class="p-5">
      <h3 id="hunter-assistant-rename-title" class="text-base font-semibold">Rename conversation</h3>
      <label class="mt-4 block text-xs font-semibold text-zinc-700 dark:text-zinc-300" for="hunter-assistant-rename-input">Title</label>
      <input id="hunter-assistant-rename-input" data-assistant-target="renameInput" type="text" maxlength="200" required
             class="mt-1.5 block w-full rounded-lg border-zinc-300 bg-white px-3 py-2 text-sm focus:border-zinc-500 focus:ring-zinc-500 dark:border-zinc-600 dark:bg-zinc-900 dark:text-zinc-100">
      <div class="mt-5 flex justify-end gap-2">
        <button type="button" data-assistant-target="renameCancel" data-action="assistant#cancelRename"
                class="rounded-lg border border-zinc-300 px-3 py-2 text-xs font-semibold text-zinc-700 hover:bg-zinc-100 focus:outline-none focus:ring-2 focus:ring-zinc-500 disabled:cursor-not-allowed disabled:opacity-40 dark:border-zinc-600 dark:text-zinc-200 dark:hover:bg-zinc-800">Cancel</button>
        <button type="submit" data-assistant-target="renameSubmit"
                class="rounded-lg bg-zinc-950 px-3 py-2 text-xs font-semibold text-white hover:bg-zinc-800 focus:outline-none focus:ring-2 focus:ring-zinc-500 focus:ring-offset-2 disabled:opacity-40 dark:bg-zinc-100 dark:text-zinc-950">Rename</button>
      </div>
    </form>
  </dialog>
  </section>
</div>
