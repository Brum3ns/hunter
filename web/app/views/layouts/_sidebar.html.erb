<% folded = cookies[:sidebar_folded] == "1" %>

<%
  brand_logo = content_tag(:svg, safe_join([
    tag.circle(cx: "12", cy: "12", r: "9", stroke: "currentColor", "stroke-width": "1.5"),
    tag.path(d: "M15.5 8.5a5 5 0 10-1 7.8", stroke: "currentColor", "stroke-width": "1.5", "stroke-linecap": "round")
  ]), xmlns: "http://www.w3.org/2000/svg", fill: "none", viewBox: "0 0 24 24", class: "h-5 w-5", "aria-hidden": "true")
%>

<div data-controller="sidebar" class="contents">
  <%# Mobile top bar with hamburger — sticks to the top while the page scrolls. %>
  <div class="sticky top-0 z-30 flex items-center gap-2 border-b border-white/10 bg-[#0a0a0a] px-2.5 py-2 text-white md:hidden">
    <button type="button" data-action="sidebar#open"
            class="inline-flex h-8 w-8 items-center justify-center rounded text-zinc-400 hover:bg-white/5 hover:text-white"
            aria-label="Open navigation">
      <%= heroicon "bars-3", classes: "h-4 w-4" %>
    </button>
    <span aria-label="hunter"><%= brand_logo %></span>
  </div>

  <%# Backdrop (mobile only, hidden until drawer opens) %>
  <div data-sidebar-target="backdrop" data-action="sidebar#close"
       class="fixed inset-0 z-30 hidden bg-black/60 md:hidden"></div>

  <%# Off-canvas drawer on mobile; on desktop it sticks to the top and fills the
      viewport height so the nav stays in place while the main content scrolls. %>
  <aside data-sidebar-target="aside"
         class="fixed inset-y-0 left-0 z-40 flex w-44 -translate-x-full flex-col border-r border-white/10 bg-[#0a0a0a] text-white transition-[width,transform] duration-200 ease-in-out md:sticky md:top-0 md:h-dvh md:translate-x-0 <%= folded ? 'md:w-12' : 'md:w-44' %>">

    <%# Brand + fold toggle %>
    <div class="flex items-center justify-between gap-2 px-2.5 py-2.5">
      <span class="<%= 'md:hidden' if folded %>" data-sidebar-target="label" aria-label="hunter"><%= brand_logo %></span>
      <button type="button" data-action="sidebar#toggle"
              class="hidden h-7 w-7 items-center justify-center rounded text-zinc-400 hover:bg-white/5 hover:text-white md:inline-flex"
              aria-label="Toggle sidebar">
        <%= heroicon "sidebar-toggle", classes: "h-3.5 w-3.5" %>
      </button>
      <%# Close button (mobile drawer) %>
      <button type="button" data-action="sidebar#close"
              class="inline-flex h-7 w-7 items-center justify-center rounded text-zinc-400 hover:bg-white/5 hover:text-white md:hidden"
              aria-label="Close navigation">
        <%= heroicon "x-mark", classes: "h-3.5 w-3.5" %>
      </button>
    </div>

    <nav class="flex flex-1 flex-col gap-0.5 overflow-y-auto px-1.5 py-1">
      <% primary_nav_groups.each_with_index do |group, index| %>
        <% if index.positive? %><hr class="my-1.5 border-white/10"><% end %>
        <% group.each do |item| %>
          <%= render "layouts/sidebar_link", path: item[:path], controllers: item[:controllers], icon: item[:icon], label: item[:label], folded: folded %>
        <% end %>
      <% end %>
    </nav>

    <%# Bottom cluster: app-level utilities %>
    <div class="flex flex-col gap-0.5 border-t border-white/10 px-1.5 py-1">
      <% utility_nav_items.each do |item| %>
        <%= render "layouts/sidebar_link", path: item[:path], controllers: item[:controllers], icon: item[:icon], label: item[:label], folded: folded %>
      <% end %>
    </div>

    <%# Footer: theme toggle + sign out %>
    <div class="flex items-center gap-1 border-t border-white/10 px-1.5 py-1.5">
      <button type="button" data-action="sidebar#toggleTheme"
              class="inline-flex h-8 min-w-8 items-center justify-center rounded px-1.5 text-zinc-400 hover:bg-white/5 hover:text-white"
              aria-label="Toggle theme">
        <span class="hidden dark:inline"><%= heroicon "sun", classes: "h-3.5 w-3.5" %></span>
        <span class="inline dark:hidden"><%= heroicon "moon", classes: "h-3.5 w-3.5" %></span>
      </button>
      <%= button_to session_path, method: :delete,
            class: "inline-flex h-8 min-w-8 flex-1 items-center justify-center gap-1.5 rounded px-1.5 text-[11px] font-medium text-zinc-400 hover:bg-white/5 hover:text-white" do %>
        <%= heroicon "user-circle", classes: "h-3.5 w-3.5" %>
        <span class="<%= 'md:hidden' if folded %>" data-sidebar-target="label">Sign out</span>
      <% end %>
    </div>
  </aside>
</div>
