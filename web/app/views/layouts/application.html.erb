<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "hunter" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="hunter">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <script>
      (function () {
        var m = document.cookie.match(/(?:^|; )theme=([^;]*)/);
        var theme = m ? decodeURIComponent(m[1]) : null;
        if (theme === "dark" || (!theme && window.matchMedia("(prefers-color-scheme: dark)").matches)) {
          document.documentElement.classList.add("dark");
        }
      })();
    </script>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="min-h-screen bg-zinc-50 text-zinc-900 antialiased dark:bg-[#0b0d0e] dark:text-zinc-100">
    <div class="flex min-h-screen flex-col md:flex-row">
      <%= render "layouts/sidebar" if authenticated? %>
      <%# overflow-x-clip (not -hidden) contains horizontal overflow WITHOUT
          making <main> a scroll container, so the page body stays the scroll
          context and `position: sticky` (nav, search, filters) works.
          min-w-0 lets this flex item shrink to its allotted width instead of
          its content width — without it, a full-bleed page with a fixed-width
          docked sibling (e.g. the Target detail panel) pushes <main> past the
          viewport and forces page-level horizontal + vertical scrollbars. %>
      <main class="min-w-0 flex-1 overflow-x-clip">
        <%# Container width is opt-in: a data-dense department can widen it with
            content_for(:container) without forking the layout. %>
        <div class="<%= content_for?(:container) ? yield(:container).strip : "mx-auto max-w-6xl px-6 py-10" %>">
          <%= yield %>
        </div>
      </main>
    </div>

    <div data-controller="toaster"
         class="pointer-events-none fixed bottom-4 right-4 z-[60] flex flex-col items-end gap-2"></div>
  </body>
</html>
