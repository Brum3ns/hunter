<%
  active = nav_active?(controllers)
  base = "group flex min-h-8 items-center gap-2 rounded px-2 text-[11px] font-medium transition-colors"
  state = active ? "bg-white text-zinc-950" : "text-zinc-400 hover:bg-white/5 hover:text-white"
%>
<%= link_to path, title: label, "aria-current": (active ? "page" : nil), class: "#{base} #{state}" do %>
  <span class="shrink-0"><%= heroicon icon, classes: "h-4 w-4" %></span>
  <span class="truncate <%= 'md:hidden' if folded %>" data-sidebar-target="label"><%= label %></span>
<% end %>
