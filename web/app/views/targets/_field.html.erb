<%# One label/value pair. Value is click-to-copy when present (reuses the shared
    `copyable` Stimulus controller). Kept local to the Target module for isolation. %>
<div class="min-w-0">
  <dt class="text-[11px] font-medium uppercase tracking-wide text-zinc-500"><%= label %></dt>
  <% if value.to_s.present? %>
    <dd data-controller="copyable"
        data-copyable-text-value="<%= value %>"
        data-copyable-label-value="<%= label %>"
        data-action="click->copyable#copy"
        title="Click to copy"
        class="group mt-0.5 flex cursor-pointer items-center gap-1 break-words font-mono text-[13px] text-zinc-200 hover:text-white">
      <span class="truncate"><%= value %></span>
      <%= heroicon "clipboard-document-list", classes: "h-3.5 w-3.5 shrink-0 opacity-0 transition-opacity group-hover:opacity-60" %>
    </dd>
  <% else %>
    <dd class="mt-0.5 font-mono text-[13px] text-zinc-600">—</dd>
  <% end %>
</div>
