<tr data-controller="rowlink"
    data-rowlink-url-value="<%= vulnerabilities_detail_path(finding.id) %>"
    data-rowlink-frame-value="vuln_panel"
    data-action="click->rowlink#open"
    class="cursor-pointer border-b border-zinc-100 last:border-0 hover:bg-zinc-50 dark:border-zinc-800/60 dark:hover:bg-white/5">
  <td class="px-4 py-3"><%= render "vulnerabilities/overview/severity_badge", severity: finding.finding["severity"] %></td>
  <td class="status-cell-<%= finding.id %> px-4 py-3"><%= render "vulnerabilities/overview/status_badge", finding: finding %></td>
  <td class="px-4 py-3 font-medium text-zinc-900 dark:text-zinc-100"><%= finding.finding["name"].presence || "—" %></td>
  <td class="px-4 py-3 text-zinc-600 dark:text-zinc-400"><%= finding.target["host"].presence || finding.target["url"].presence || finding.target["input"].presence || "—" %></td>
  <td class="px-4 py-3 text-zinc-600 dark:text-zinc-400"><%= finding.metadata["tool"].presence || "—" %></td>
  <td class="px-4 py-3 text-zinc-500 dark:text-zinc-400"><%= finding.metadata["date"].presence || "—" %></td>
</tr>
