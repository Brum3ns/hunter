<%= form_with url: vulnerabilities_status_path(finding.id), method: :patch,
      data: { controller: "status-select" }, class: "inline-block leading-none" do |f| %>
  <%= f.select :status,
        status_select_options,
        { selected: display_status(finding.report["status"]) },
        class: "appearance-none cursor-pointer rounded-full px-2.5 py-1 text-xs font-medium ring-1 ring-inset transition-colors focus:outline-none focus:ring-2 #{status_badge_classes(finding.report["status"])}",
        data: { action: "change->status-select#submit" } %>
<% end %>
