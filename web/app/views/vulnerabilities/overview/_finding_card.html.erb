<div data-controller="rowlink"
     data-rowlink-url-value="<%= vulnerabilities_detail_path(finding.id) %>"
     data-rowlink-frame-value="vuln_panel"
     data-action="click->rowlink#open"
     class="cursor-pointer border-b border-zinc-100 p-4 last:border-0 hover:bg-zinc-50 dark:border-zinc-800/60 dark:hover:bg-white/5">
  <div class="flex items-center justify-between gap-3">
    <%= render "vulnerabilities/overview/severity_badge", severity: finding.finding["severity"] %>
    <div class="status-cell-<%= finding.id %>"><%= render "vulnerabilities/overview/status_badge", finding: finding %></div>
  </div>
  <p class="mt-2 font-medium text-zinc-900 dark:text-zinc-100"><%= finding.finding["name"].presence || "—" %></p>
  <p class="mt-0.5 break-all text-sm text-zinc-600 dark:text-zinc-400"><%= finding.target["host"].presence || finding.target["url"].presence || finding.target["input"].presence || "—" %></p>
  <div class="mt-2 flex flex-wrap gap-x-4 gap-y-0.5 text-xs text-zinc-500 dark:text-zinc-400">
    <span><span class="text-zinc-400 dark:text-zinc-500">Tool:</span> <%= finding.metadata["tool"].presence || "—" %></span>
    <span><span class="text-zinc-400 dark:text-zinc-500">Date:</span> <%= finding.metadata["date"].presence || "—" %></span>
  </div>
</div>
