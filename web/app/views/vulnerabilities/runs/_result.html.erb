<%# Result frame for a runner curl job.

    The frame carries NO `src`: polling is driven by the `poller` controller on
    the inner wrapper, which fetches the job endpoint and applies a Turbo Stream
    that replaces this whole frame. When the job is terminal the wrapper drops
    the controller, so polling stops and the final result stays put (nothing
    re-fetches it away). See poller_controller.js. %>
<%
  status_classes =
    case job.status
    when "succeeded" then "bg-emerald-50 text-emerald-700 ring-emerald-600/20 dark:bg-emerald-500/10 dark:text-emerald-300 dark:ring-emerald-400/20"
    when "failed"    then "bg-rose-50 text-rose-700 ring-rose-600/20 dark:bg-rose-500/10 dark:text-rose-300 dark:ring-rose-400/20"
    when "running"   then "bg-amber-50 text-amber-700 ring-amber-600/20 dark:bg-amber-500/10 dark:text-amber-300 dark:ring-amber-400/20"
    else                  "bg-zinc-100 text-zinc-600 ring-zinc-500/20 dark:bg-zinc-800 dark:text-zinc-300 dark:ring-zinc-500/20"
    end
%>
<%= turbo_frame_tag "runner_run_#{job.vulnerability_id}" do %>
  <%= tag.div data: (job.terminal? ? {} : { controller: "poller", poller_url_value: vulnerabilities_run_path(job.vulnerability_id, job.id, format: :turbo_stream), poller_interval_value: 1500 }) do %>
    <div class="overflow-hidden rounded-lg border border-zinc-200 dark:border-zinc-800">
      <div class="flex items-center gap-2 border-b border-zinc-200 bg-zinc-50 px-3 py-2 text-xs dark:border-zinc-800 dark:bg-zinc-900/60">
        <span class="inline-flex items-center gap-1.5 rounded-full px-2 py-0.5 font-medium ring-1 ring-inset <%= status_classes %>">
          <% unless job.terminal? %>
            <span class="h-1.5 w-1.5 animate-pulse rounded-full bg-current"></span>
          <% end %>
          <%= job.status %>
        </span>
        <% unless job.exit_status.nil? %>
          <span class="text-zinc-500 dark:text-zinc-400">exit <%= job.exit_status %></span>
        <% end %>
        <% if job.duration_ms %>
          <span class="text-zinc-500 dark:text-zinc-400"><%= job.duration_ms %> ms</span>
        <% end %>
        <% if job.output_truncated %>
          <span class="text-amber-600 dark:text-amber-400">truncated</span>
        <% end %>
      </div>

      <div class="p-3">
        <% if job.error.present? %>
          <div class="flex items-start gap-2 rounded-md bg-rose-50 px-3 py-2 text-sm text-rose-700 ring-1 ring-inset ring-rose-600/20 dark:bg-rose-500/10 dark:text-rose-300 dark:ring-rose-400/20">
            <%= heroicon "shield-exclamation", classes: "mt-0.5 h-4 w-4 flex-none" %>
            <span><%= job.error %></span>
          </div>
        <% elsif job.terminal? %>
          <% if job.stdout.present? %>
            <%= render "vulnerabilities/details/code_block", title: "response", content: job.stdout %>
          <% end %>
          <% if job.stderr.present? %>
            <div class="<%= "mt-3" if job.stdout.present? %>">
              <%= render "vulnerabilities/details/code_block", title: "stderr", content: job.stderr %>
            </div>
          <% end %>
          <% if job.stdout.blank? && job.stderr.blank? %>
            <p class="text-sm text-zinc-500 dark:text-zinc-400">Completed with no output.</p>
          <% end %>
        <% else %>
          <div class="flex items-center gap-2 text-sm text-zinc-500 dark:text-zinc-400">
            <svg class="h-4 w-4 animate-spin text-zinc-400 dark:text-zinc-500" viewBox="0 0 24 24" fill="none" aria-hidden="true">
              <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
              <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 0 1 8-8v4a4 4 0 0 0-4 4H4z"></path>
            </svg>
            <span><%= job.status == "queued" ? "Waiting for a runner…" : "Running…" %></span>
          </div>
        <% end %>
      </div>
    </div>
  <% end %>
<% end %>
