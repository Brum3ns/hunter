<% language = local_assigns[:language] %>
<% body_mime = local_assigns[:body_mime] %>
<div data-controller="clipboard code-fit" class="overflow-hidden rounded-md border border-zinc-200 dark:border-zinc-800">
  <div class="flex items-center justify-between border-b border-zinc-200 bg-zinc-50 px-3 py-1.5 dark:border-zinc-800 dark:bg-zinc-900/60">
    <span class="text-[11px] font-medium uppercase tracking-wide text-zinc-500 dark:text-zinc-400"><%= title %></span>
    <div class="flex items-center gap-1">
      <button type="button" data-action="code-fit#toggle"
              class="inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-[11px] font-medium text-zinc-500 hover:bg-zinc-200 hover:text-zinc-800 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100">
        <%= heroicon "arrows-pointing-in", classes: "h-3.5 w-3.5" %>
        <span data-code-fit-target="label">Fit window</span>
      </button>
      <button type="button" data-action="clipboard#copy" data-clipboard-target="button"
              class="inline-flex items-center gap-1 rounded px-1.5 py-0.5 text-[11px] font-medium text-zinc-500 hover:bg-zinc-200 hover:text-zinc-800 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100">
        <%= heroicon "clipboard-document-list", classes: "h-3.5 w-3.5" %>
        Copy
      </button>
    </div>
  </div>
  <pre data-code-fit-target="pre" class="slim-scroll max-h-72 overflow-auto bg-zinc-950 px-3 py-2.5 font-mono text-xs leading-relaxed text-zinc-100"><code data-clipboard-target="source"<% if language || body_mime %> data-controller="highlight"<% if language %> data-highlight-language-value="<%= language %>"<% end %><% if body_mime %> data-highlight-body-mime-value="true"<% end %><% end %> class="whitespace-pre"><%= content %></code></pre>
</div>
