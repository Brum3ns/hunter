<%# Monthly column chart. locals: `series` [{ label:, year:, count: }] in
    chronological order. Columns scale to the busiest month; empty months keep a
    hairline so the axis stays legible. Plain divs (no SVG) so bars can't distort
    and the whole thing reflows responsively. %>
<% max = series.map { |p| p[:count] }.max || 0 %>
<% if max.zero? %>
  <%= render "vulnerabilities/statistics/empty", message: "No dated findings yet." %>
<% else %>
  <div class="flex items-end gap-1.5" style="height: 160px">
    <% series.each do |point| %>
      <% height = point[:count].positive? ? [(point[:count].to_f / max * 128).round, 4].max : 1 %>
      <div class="flex h-full flex-1 flex-col items-center justify-end gap-1.5">
        <div class="w-full max-w-[26px] rounded-t bg-current text-zinc-800 transition-colors hover:text-zinc-950 dark:text-zinc-300 dark:hover:text-white"
             style="height: <%= height %>px"
             title="<%= point[:count] %> in <%= point[:label] %> <%= point[:year] %>"></div>
        <span class="text-[10px] tabular-nums text-zinc-400 dark:text-zinc-500"><%= point[:label] %></span>
      </div>
    <% end %>
  </div>
<% end %>
