<%# Horizontal bar list. locals: `rows` [{ label:, count:, color? }]. Bars are
    scaled to the largest row so the leader fills the track. `color` is an
    optional Tailwind text-* class (via bg-current); rows without one render in
    a neutral zinc. %>
<% max = rows.map { |r| r[:count] }.max || 0 %>
<% if rows.blank? || max.zero? %>
  <%= render "vulnerabilities/statistics/empty" %>
<% else %>
  <ul class="space-y-3">
    <% rows.each do |row| %>
      <% pct = (row[:count].to_f / max * 100).round(1) %>
      <li>
        <div class="flex items-center justify-between gap-3 text-sm">
          <span class="min-w-0 truncate text-zinc-600 dark:text-zinc-300" title="<%= row[:label] %>"><%= row[:label] %></span>
          <span class="shrink-0 font-medium tabular-nums text-zinc-900 dark:text-zinc-100"><%= number_with_delimiter(row[:count]) %></span>
        </div>
        <div class="mt-1 h-2 w-full overflow-hidden rounded-full bg-zinc-100 dark:bg-zinc-800">
          <div class="h-full rounded-full bg-current <%= row[:color] || 'text-zinc-400 dark:text-zinc-500' %>"
               style="width: <%= [pct, 2].max %>%"></div>
        </div>
      </li>
    <% end %>
  </ul>
<% end %>
