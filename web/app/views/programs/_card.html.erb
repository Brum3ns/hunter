<%# One program as a card. Clicking opens the detail modal; the star/trash
    toggles and the external-link button stop propagation so they never open
    it. Monochrome skin — no platform banner/logo images. %>
<% fav = favorited_sids.include?(program.sid) %>
<% trashed = trashed_sids.include?(program.sid) %>
<div data-controller="modal" data-program-card="true">
  <article data-action="click->modal#open"
           class="group relative cursor-pointer overflow-hidden rounded-xl border border-zinc-200 bg-white shadow-sm transition hover:border-zinc-300 dark:border-zinc-800 dark:bg-[#111315] dark:hover:border-zinc-700">

    <div class="flex items-start justify-between gap-3 border-b border-zinc-100 p-4 dark:border-zinc-800">
      <div class="min-w-0">
        <h2 class="truncate text-base font-semibold leading-tight text-zinc-900 dark:text-zinc-100"><%= program.name %></h2>
        <p class="mt-0.5 truncate text-xs text-zinc-500 dark:text-zinc-400"><%= program.slug %></p>
      </div>
      <div class="flex shrink-0 items-center gap-1">
        <button type="button"
                data-controller="favorite-toggle"
                data-favorite-toggle-sid-value="<%= program.sid %>"
                data-favorite-toggle-favorited-value="<%= fav %>"
                data-action="click->favorite-toggle#toggle"
                data-favorited="<%= fav %>"
                title="<%= fav ? "Remove from favorites" : "Add to favorites" %>"
                aria-label="<%= fav ? "Unfavorite" : "Favorite" %>"
                class="inline-flex h-7 w-7 items-center justify-center rounded-full transition <%= fav ? "text-zinc-900 dark:text-white" : "text-zinc-400" %>">
          <%= heroicon "star", classes: "h-4 w-4" %>
        </button>
        <button type="button"
                data-controller="trash-toggle"
                data-trash-toggle-sid-value="<%= program.sid %>"
                data-trash-toggle-trashed-value="<%= trashed %>"
                data-action="click->trash-toggle#toggle"
                data-trashed="<%= trashed %>"
                title="<%= trashed ? "Restore from trash" : "Move to trash" %>"
                aria-label="<%= trashed ? "Restore from trash" : "Move to trash" %>"
                class="inline-flex h-7 w-7 items-center justify-center rounded-full transition <%= trashed ? "text-zinc-900 dark:text-white" : "text-zinc-400" %>">
          <%= heroicon "trash", classes: "h-4 w-4" %>
        </button>
      </div>
    </div>

    <div class="space-y-4 p-4">
      <div class="flex items-center gap-2">
        <span class="inline-flex items-center rounded border border-zinc-200 px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-[0.08em] text-zinc-600 dark:border-zinc-700 dark:text-zinc-400">
          <%= program.platform %>
        </span>
        <span class="inline-flex items-center rounded border px-1.5 py-0.5 text-[10px] font-medium uppercase tracking-[0.08em] <%= program.public? ? "border-zinc-200 text-zinc-600 dark:border-zinc-700 dark:text-zinc-400" : "border-zinc-300 bg-zinc-100 text-zinc-700 dark:border-zinc-600 dark:bg-zinc-800 dark:text-zinc-200" %>">
          <%= program.public? ? "Public" : "Private" %>
        </span>
      </div>

      <dl class="grid grid-cols-3 gap-2 text-center">
        <div class="rounded-md border border-zinc-200 py-2 dark:border-zinc-800">
          <dt class="text-[10px] uppercase tracking-[0.08em] text-zinc-500 dark:text-zinc-400">Bounty</dt>
          <dd class="mt-0.5 text-xs text-zinc-900 dark:text-zinc-100"><%= program.bounty? ? "Yes" : "No" %></dd>
        </div>
        <div class="rounded-md border border-zinc-200 py-2 dark:border-zinc-800">
          <dt class="text-[10px] uppercase tracking-[0.08em] text-zinc-500 dark:text-zinc-400">Scope</dt>
          <dd class="mt-0.5 text-xs tabular-nums text-zinc-900 dark:text-zinc-100"><%= program.scope_count %></dd>
        </div>
        <div class="rounded-md border border-zinc-200 py-2 dark:border-zinc-800">
          <dt class="text-[10px] uppercase tracking-[0.08em] text-zinc-500 dark:text-zinc-400">Reports</dt>
          <dd class="mt-0.5 text-xs tabular-nums text-zinc-900 dark:text-zinc-100"><%= program.report_count %></dd>
        </div>
      </dl>

      <dl class="grid grid-cols-4 gap-1.5 text-center">
        <div class="rounded border border-zinc-200 py-1.5 dark:border-zinc-800">
          <dt class="text-[9px] uppercase tracking-[0.08em] text-zinc-500 dark:text-zinc-400">Avg</dt>
          <dd class="mt-0.5 text-[11px] tabular-nums <%= program.reward_avg.to_f > 0 ? "text-zinc-700 dark:text-zinc-300" : "text-zinc-400 dark:text-zinc-500" %>">
            <%= program.reward_avg.to_f > 0 ? "#{program.currency_symbol}#{number_with_delimiter(program.reward_avg.to_i)}" : "—" %>
          </dd>
        </div>
        <% [["24h", program.reports_24h], ["7d", program.reports_7d], ["30d", program.reports_month]].each do |label, val| %>
          <div class="rounded border border-zinc-200 py-1.5 dark:border-zinc-800">
            <dt class="text-[9px] uppercase tracking-[0.08em] text-zinc-500 dark:text-zinc-400"><%= label %></dt>
            <dd class="mt-0.5 text-[11px] tabular-nums <%= val > 0 ? "text-zinc-700 dark:text-zinc-300" : "text-zinc-400 dark:text-zinc-500" %>">
              <%= val > 0 ? val : "—" %>
            </dd>
          </div>
        <% end %>
      </dl>

      <footer class="grid grid-cols-[1fr_auto_1fr] items-center gap-2 pt-1">
        <% if program.collaboration? %>
          <span class="justify-self-start inline-flex items-center gap-1.5 text-[10px] text-zinc-600 dark:text-zinc-300">
            <span class="h-1.5 w-1.5 rounded-full bg-zinc-500 dark:bg-zinc-300"></span>
            collab
          </span>
        <% else %>
          <span class="justify-self-start"></span>
        <% end %>

        <span class="justify-self-center whitespace-nowrap text-sm font-semibold tabular-nums <%= program.bounty? ? "text-zinc-900 dark:text-zinc-100" : "text-zinc-400 dark:text-zinc-500" %>">
          <%= program.bounty_range %>
        </span>

        <% if program.url? %>
          <a href="<%= program.url %>" target="_blank" rel="noopener noreferrer"
             aria-label="Open program on <%= program.platform %>"
             title="Open program on <%= program.platform %>"
             class="justify-self-end inline-flex h-7 w-7 items-center justify-center rounded-md border border-zinc-200 text-zinc-500 transition hover:border-zinc-300 hover:text-zinc-900 dark:border-zinc-800 dark:text-zinc-400 dark:hover:text-white">
            <%= heroicon "arrow-top-right-on-square", classes: "h-4 w-4" %>
          </a>
        <% else %>
          <span class="justify-self-end"></span>
        <% end %>
      </footer>
    </div>
  </article>
  <%= render "programs/modal", program: program %>
</div>
