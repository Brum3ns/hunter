<% content_for :title, "hunter — Program monitor" %>
<% content_for :container, "mx-auto max-w-screen-2xl px-6 py-10" %>

<header class="flex items-center gap-3">
  <h1 class="text-2xl font-semibold text-zinc-900 dark:text-zinc-100">Programs</h1>
  <span class="rounded border border-zinc-300 px-1.5 py-0.5 text-xs font-medium text-zinc-600 dark:border-zinc-700 dark:text-zinc-400">beta</span>
</header>
<p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Live feed of scope changes across your monitored programs.</p>

<%= render "layouts/department_tabs", label: "Programs sections" %>

<section class="mt-6"
         data-controller="programs-monitor"
         data-programs-monitor-url-value="<%= api_v1_programs_changes_path %>"
         data-programs-monitor-modal-url-value="/programs/SID/modal"
         data-programs-monitor-poll-value="5000">

  <%# --- filter bar --- %>
  <div class="flex flex-wrap items-center gap-2 rounded-lg border border-zinc-200 bg-white p-2 dark:border-zinc-800 dark:bg-[#111315]">
    <select data-programs-monitor-target="platform" data-action="programs-monitor#filter"
            class="rounded-md border border-zinc-300 bg-white px-2 py-1.5 text-sm text-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100">
      <option value="">All platforms</option>
      <% @platforms.each do |p| %><option value="<%= p %>"><%= p.humanize %></option><% end %>
    </select>

    <select data-programs-monitor-target="kind" data-action="programs-monitor#filter"
            class="rounded-md border border-zinc-300 bg-white px-2 py-1.5 text-sm text-zinc-900 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100">
      <option value="">All changes</option>
      <% @kinds.each do |k| %><option value="<%= k %>"><%= k.humanize %></option><% end %>
    </select>

    <input type="search" placeholder="Program slug…" data-programs-monitor-target="sid" data-action="input->programs-monitor#filterDebounced"
           class="min-w-[10rem] flex-1 rounded-md border border-zinc-300 bg-white px-2.5 py-1.5 text-sm text-zinc-900 placeholder-zinc-400 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-100 dark:placeholder-zinc-600">

    <label class="inline-flex items-center gap-1.5 px-1 text-sm text-zinc-600 dark:text-zinc-300">
      <input type="checkbox" checked data-programs-monitor-target="live" data-action="programs-monitor#toggleLive"
             class="rounded border-zinc-300 dark:border-zinc-700">
      <span class="inline-flex items-center gap-1.5">
        <span class="h-2 w-2 rounded-full bg-emerald-500" data-programs-monitor-target="liveDot"></span>Live
      </span>
    </label>

    <button type="button" data-action="programs-monitor#refresh"
            class="inline-flex items-center gap-1.5 rounded-md border border-zinc-300 px-2.5 py-1.5 text-sm font-medium text-zinc-700 hover:bg-zinc-100 dark:border-zinc-700 dark:text-zinc-200 dark:hover:bg-zinc-800">
      <%= heroicon "clock", classes: "h-4 w-4" %> Refresh
    </button>
  </div>

  <%# --- feed --- %>
  <div class="mt-4 overflow-hidden rounded-lg border border-zinc-200 bg-white dark:border-zinc-800 dark:bg-[#111315]">
    <div class="flex items-center justify-between border-b border-zinc-100 px-4 py-2 text-xs text-zinc-500 dark:border-zinc-800 dark:text-zinc-400">
      <span data-programs-monitor-target="counter">—</span>
    </div>

    <ul data-programs-monitor-target="rows" class="divide-y divide-zinc-100 dark:divide-zinc-800/70"></ul>

    <div data-programs-monitor-target="empty" class="hidden px-4 py-12 text-center text-sm text-zinc-400 dark:text-zinc-500">
      No program changes recorded yet.
    </div>

    <div class="border-t border-zinc-100 px-4 py-3 text-center dark:border-zinc-800">
      <button type="button" data-programs-monitor-target="loadMore" data-action="programs-monitor#loadMore"
              class="hidden text-xs font-medium text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-100">
        Load older
      </button>
    </div>
  </div>

  <%# Modal host — a program row click fetches /programs/:sid/modal into here. %>
  <div data-controller="modal" data-programs-monitor-target="modalHost"></div>
</section>
