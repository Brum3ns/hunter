<%# Faceted filter panel. Inline (not a fixed overlay) so it sits beside the
    catalog the way Hunter's vuln facets do: on small screens it folds into a
    "Filters" drawer (native <details class="facet-shell">), on desktop it is
    always open. All inputs live inside the page's single GET form, so the
    Apply button (or any auto-submit) carries the whole selection. %>
<%
  group   = "border-b border-zinc-100 pb-3 last:border-0 dark:border-zinc-800/60"
  summary = "facet-summary flex cursor-pointer items-center justify-between text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400"
  chevron = "h-4 w-4 shrink-0 text-zinc-400 transition-transform group-open:rotate-180"
  checkbox = "shrink-0 rounded border-zinc-300 text-zinc-900 focus:ring-0 dark:border-zinc-600 dark:bg-zinc-800"
  radio    = "shrink-0 border-zinc-300 text-zinc-900 focus:ring-0 dark:border-zinc-600 dark:bg-zinc-800"
  bounty_step = bounty_ceiling >= 10_000 ? 500 : 50
%>
<details class="facet-shell rounded-lg border border-zinc-200 bg-white p-4 dark:border-zinc-800 dark:bg-[#111315]" open>
  <summary class="facet-summary mb-3 flex cursor-pointer items-center justify-between text-sm font-semibold text-zinc-900 lg:hidden dark:text-zinc-100">
    Filters
    <%= heroicon "adjustments-horizontal", classes: "h-4 w-4 text-zinc-400" %>
  </summary>

  <div class="facet-shell-body space-y-4">
    <div class="flex items-center justify-between">
      <h2 class="text-xs font-semibold uppercase tracking-wider text-zinc-500 dark:text-zinc-400">Filters</h2>
      <%= link_to programs_root_path, title: "Clear filters",
            class: "inline-flex items-center gap-1 text-[11px] font-medium uppercase tracking-[0.08em] text-zinc-400 transition hover:text-zinc-900 dark:hover:text-white" do %>
        <%= heroicon "trash", classes: "h-3.5 w-3.5" %>
        Clear
      <% end %>
    </div>

    <%# Favorites / trash quick toggles %>
    <div class="space-y-2 <%= group %>">
      <% fav_on = filter_params[:favorites_only].to_s == "yes" %>
      <label class="flex cursor-pointer items-center gap-2 text-sm text-zinc-700 dark:text-zinc-300">
        <%= check_box_tag :favorites_only, "yes", fav_on, id: "favorites_only", class: checkbox %>
        <span class="flex items-center gap-1.5">
          <%= heroicon "star", classes: "h-4 w-4 text-zinc-400" %>
          Favorites only
        </span>
      </label>
      <% trash_on = filter_params[:trash_only].to_s == "yes" %>
      <label class="flex cursor-pointer items-center gap-2 text-sm text-zinc-700 dark:text-zinc-300">
        <%= check_box_tag :trash_only, "yes", trash_on, id: "trash_only", class: checkbox %>
        <span class="flex items-center gap-1.5">
          <%= heroicon "trash", classes: "h-4 w-4 text-zinc-400" %>
          Trash only
        </span>
      </label>
    </div>

    <%# Platform %>
    <% if platforms.any? %>
      <details class="group <%= group %>" open>
        <summary class="<%= summary %>">
          Platform
          <%= heroicon "chevron-down", classes: chevron %>
        </summary>
        <div class="mt-2 space-y-1">
          <% platforms.each do |platform| %>
            <label class="flex cursor-pointer items-center gap-2 text-sm text-zinc-700 dark:text-zinc-300">
              <%= check_box_tag "platforms[]", platform, Array(filter_params[:platforms]).include?(platform), id: "p_#{platform}", class: checkbox %>
              <span class="capitalize"><%= platform %></span>
            </label>
          <% end %>
        </div>
      </details>
    <% end %>

    <%# Status %>
    <details class="group <%= group %>">
      <summary class="<%= summary %>">
        Status
        <%= heroicon "chevron-down", classes: chevron %>
      </summary>
      <div class="mt-2 space-y-1">
        <% { "" => "Any", "public" => "Public", "private" => "Private" }.each do |value, label| %>
          <label class="flex cursor-pointer items-center gap-2 text-sm text-zinc-700 dark:text-zinc-300">
            <%= radio_button_tag :status, value, filter_params[:status].to_s == value, class: radio %>
            <%= label %>
          </label>
        <% end %>
      </div>
    </details>

    <%# Bounty %>
    <details class="group <%= group %>">
      <summary class="<%= summary %>">
        Bounty
        <%= heroicon "chevron-down", classes: chevron %>
      </summary>
      <div class="mt-2 space-y-1">
        <% { "" => "Any", "with" => "With bounty", "without" => "No bounty (VDP)" }.each do |value, label| %>
          <label class="flex cursor-pointer items-center gap-2 text-sm text-zinc-700 dark:text-zinc-300">
            <%= radio_button_tag :bounty, value, filter_params[:bounty].to_s == value, class: radio %>
            <%= label %>
          </label>
        <% end %>
      </div>
    </details>

    <%# Bounty range %>
    <details class="group <%= group %>">
      <summary class="<%= summary %>">
        Bounty range
        <%= heroicon "chevron-down", classes: chevron %>
      </summary>
      <div class="mt-3 space-y-3">
        <%= render "programs/filter_range", name: :bounty_min_gte, label: "Min bounty ≥", value: filter_params[:bounty_min_gte], min: 0, max: bounty_ceiling, step: bounty_step, format: "money" %>
        <%= render "programs/filter_range", name: :bounty_max_gte, label: "Max bounty ≥", value: filter_params[:bounty_max_gte], min: 0, max: bounty_ceiling, step: bounty_step, format: "money" %>
      </div>
    </details>

    <%# Reports %>
    <details class="group <%= group %>">
      <summary class="<%= summary %>">
        Reports
        <%= heroicon "chevron-down", classes: chevron %>
      </summary>
      <div class="mt-3 space-y-3">
        <%= render "programs/filter_range", name: :reports_gte,       label: "Total",      value: filter_params[:reports_gte],       min: 0, max: 1000, step: 5 %>
        <%= render "programs/filter_range", name: :reports_24h_gte,   label: "Last 24h",   value: filter_params[:reports_24h_gte],   min: 0, max: 50,   step: 1 %>
        <%= render "programs/filter_range", name: :reports_7d_gte,    label: "Last 7d",    value: filter_params[:reports_7d_gte],    min: 0, max: 200,  step: 1 %>
        <%= render "programs/filter_range", name: :reports_month_gte, label: "This month", value: filter_params[:reports_month_gte], min: 0, max: 500,  step: 5 %>
      </div>
    </details>

    <%# Scope %>
    <details class="group <%= group %>">
      <summary class="<%= summary %>">
        Scope
        <%= heroicon "chevron-down", classes: chevron %>
      </summary>
      <div class="mt-3 space-y-3">
        <%= render "programs/filter_dual_range",
              name_min: :scope_count_gte, name_max: :scope_count_lte,
              label: "Count",
              value_min: filter_params[:scope_count_gte], value_max: filter_params[:scope_count_lte],
              min: 0, max: 200, step: 1 %>
        <% if scope_types.any? %>
          <div class="space-y-1.5 pt-1">
            <p class="text-[11px] uppercase tracking-[0.06em] text-zinc-500 dark:text-zinc-400">Asset types</p>
            <% scope_types.each do |type| %>
              <label class="flex cursor-pointer items-center gap-2 text-sm text-zinc-700 dark:text-zinc-300">
                <%= check_box_tag "scope_types[]", type, Array(filter_params[:scope_types]).include?(type), id: "st_#{type}", class: checkbox %>
                <span><%= Programs::ScopeType.label_for(type) %></span>
              </label>
            <% end %>
          </div>
        <% end %>
      </div>
    </details>

    <%# Collaboration %>
    <details class="group <%= group %>">
      <summary class="<%= summary %>">
        Collaboration
        <%= heroicon "chevron-down", classes: chevron %>
      </summary>
      <div class="mt-2 space-y-1">
        <% { "" => "Any", "yes" => "Collab only", "no" => "No collab" }.each do |value, label| %>
          <label class="flex cursor-pointer items-center gap-2 text-sm text-zinc-700 dark:text-zinc-300">
            <%= radio_button_tag :collaboration, value, filter_params[:collaboration].to_s == value, class: radio %>
            <%= label %>
          </label>
        <% end %>
      </div>
    </details>

    <%# Response time %>
    <details class="group <%= group %>">
      <summary class="<%= summary %>">
        Response time
        <%= heroicon "chevron-down", classes: chevron %>
      </summary>
      <div class="mt-3 space-y-3">
        <%= render "programs/filter_range", name: :response_lte, label: "Avg response ≤", value: filter_params[:response_lte], min: 0, max: 168, step: 1, format: "hours" %>
      </div>
    </details>

    <div class="flex items-center gap-2 pt-1">
      <%= submit_tag "Apply filters",
            class: "min-w-0 flex-1 cursor-pointer rounded-md bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200" %>
      <%= link_to "Reset", programs_root_path,
            class: "shrink-0 rounded-md px-3 py-1.5 text-sm font-medium text-zinc-500 hover:text-zinc-800 dark:text-zinc-400 dark:hover:text-zinc-100" %>
    </div>
  </div>
</details>
