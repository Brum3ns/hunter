<% content_for :title, "hunter — Settings" %>
<% content_for :container, "mx-auto max-w-6xl px-6 py-10" %>

<header>
  <h1 class="text-2xl font-semibold text-zinc-900 dark:text-zinc-100">Settings</h1>
  <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Everything configurable in hunter, in one place.</p>
</header>

<% if notice.present? %>
  <div class="mt-4 rounded-md bg-emerald-50 px-3 py-2 text-sm text-emerald-700 ring-1 ring-inset ring-emerald-600/20 dark:bg-emerald-500/10 dark:text-emerald-300 dark:ring-emerald-400/20"><%= notice %></div>
<% end %>
<% if alert.present? %>
  <div class="mt-4 rounded-md bg-rose-50 px-3 py-2 text-sm text-rose-700 ring-1 ring-inset ring-rose-600/20 dark:bg-rose-500/10 dark:text-rose-300 dark:ring-rose-400/20"><%= alert %></div>
<% end %>

<div class="mt-8 flex flex-col gap-8 lg:flex-row lg:items-start">
  <%# Sticky section nav — every settings area is reachable from here. %>
  <nav class="shrink-0 lg:sticky lg:top-6 lg:w-48" aria-label="Settings sections">
    <p class="px-2 text-xs font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">Access</p>
    <a href="#runners" class="block rounded px-2 py-1.5 text-sm text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100">Runners</a>
    <a href="#ansible-credentials" class="block rounded px-2 py-1.5 text-sm text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100">Ansible credentials</a>

    <p class="mt-4 px-2 text-xs font-semibold uppercase tracking-wider text-zinc-400 dark:text-zinc-500">Programs · Scope</p>
    <a href="#credentials" class="block rounded px-2 py-1.5 text-sm text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100">Platform credentials</a>
    <a href="#schedule" class="block rounded px-2 py-1.5 text-sm text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100">Fetch schedule</a>
    <a href="#monitor" class="block rounded px-2 py-1.5 text-sm text-zinc-600 hover:bg-zinc-100 hover:text-zinc-900 dark:text-zinc-400 dark:hover:bg-zinc-800 dark:hover:text-zinc-100">Monitor</a>
  </nav>

  <div class="min-w-0 flex-1 space-y-10">
    <%= render "settings/runners", runners: @runners %>
    <%= render "settings/ansible_credentials", credentials: @ansible_credentials %>
    <%= render "settings/credentials" %>
    <%= render "settings/schedule", schedule: @schedule %>
    <%= render "settings/monitor", monitor_config: @monitor_config %>
  </div>
</div>
