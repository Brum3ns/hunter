<section id="assistant" class="scroll-mt-6">
  <div class="flex items-start justify-between gap-4">
    <div>
      <h2 class="text-lg font-semibold text-zinc-900 dark:text-zinc-100">Assistant</h2>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Session-only administration for the drafting assistant. Enabled profiles may read Hunter data (targets, CVEs, vulnerabilities, sitemap, programs, control center) through bounded, read-only tools, and only when you explicitly ask for a lookup. When Control Center write is enabled, they may also create (but not edit, delete, or run) new validated Whiterabbit templates and Ansible playbooks, attributed to you and audited; they cannot execute or send anything on their own.</p>
    </div>
    <span class="rounded-full px-2.5 py-1 text-xs font-medium <%= Assistant::Config.enabled? && setting.assistant_enabled? ? 'bg-emerald-100 text-emerald-700 dark:bg-emerald-500/15 dark:text-emerald-300' : 'bg-rose-100 text-rose-700 dark:bg-rose-500/15 dark:text-rose-300' %>">
      <%= Assistant::Config.enabled? && setting.assistant_enabled? ? "Enabled" : "Disabled" %>
    </span>
  </div>

  <div class="mt-4 rounded-lg border border-amber-300 bg-amber-50 p-4 text-sm text-amber-900 dark:border-amber-700 dark:bg-amber-950/30 dark:text-amber-200">
    The database switch and the infrastructure gate must both be enabled. Turning this switch off stops new conversations immediately.
  </div>

  <%= form_with url: api_v1_assistant_settings_path, method: :patch,
    class: "mt-5 grid gap-4 rounded-lg border border-zinc-200 p-4 dark:border-zinc-800",
    data: { turbo: false } do %>
    <label class="flex items-center gap-3 text-sm text-zinc-700 dark:text-zinc-300">
      <%= check_box_tag "settings[assistant_enabled]", "1", setting.assistant_enabled?, class: "rounded border-zinc-300" %>
      Enable assistant in Hunter
    </label>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="text-sm text-zinc-700 dark:text-zinc-300">
        Transcript retention (days)
        <%= number_field_tag "settings[transcript_retention_days]", setting.transcript_retention_days,
          min: 1, max: 30, required: true,
          class: "mt-1 block w-full rounded-md border-zinc-300 bg-white dark:border-zinc-700 dark:bg-zinc-900" %>
      </label>
      <label class="text-sm text-zinc-700 dark:text-zinc-300">
        Security audit retention (days)
        <%= number_field_tag "settings[audit_retention_days]", setting.audit_retention_days,
          min: 1, max: 365, required: true,
          class: "mt-1 block w-full rounded-md border-zinc-300 bg-white dark:border-zinc-700 dark:bg-zinc-900" %>
      </label>
    </div>
    <div><%= submit_tag "Save assistant settings", class: "rounded-md bg-zinc-900 px-3 py-2 text-sm font-medium text-white dark:bg-zinc-100 dark:text-zinc-900" %></div>
  <% end %>

  <div class="mt-6">
    <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Reviewed provider profiles</h3>
    <div class="mt-3 space-y-3">
      <% profiles.each do |profile| %>
        <article class="rounded-lg border border-zinc-200 p-4 dark:border-zinc-800">
          <div class="flex items-center justify-between gap-3">
            <p class="font-medium text-zinc-900 dark:text-zinc-100"><%= profile.name %></p>
            <span class="text-xs text-zinc-500"><%= profile.enabled? ? "Enabled" : "Disabled" %></span>
          </div>
          <p class="mt-1 text-sm text-zinc-600 dark:text-zinc-400"><%= profile.provider %> · <%= profile.model %></p>
          <dl class="mt-3 grid gap-2 text-xs text-zinc-500 sm:grid-cols-2">
            <div><dt class="font-medium">Retention posture</dt><dd><%= profile.retention_posture.humanize %></dd></div>
            <div><dt class="font-medium">Reviewed</dt><dd><%= profile.reviewed_at&.to_fs(:long) || "Not reviewed" %></dd></div>
            <div><dt class="font-medium">Input/output limits</dt><dd><%= profile.input_limit %> / <%= profile.output_limit %></dd></div>
            <div><dt class="font-medium">Tool-call limit</dt><dd><%= profile.tool_call_limit %></dd></div>
          </dl>
        </article>
      <% end %>
    </div>
  </div>

  <%= form_with url: api_v1_assistant_provider_profiles_path, method: :post,
    class: "mt-6 grid gap-4 rounded-lg border border-zinc-200 p-4 dark:border-zinc-800",
    data: { turbo: false } do %>
    <h3 class="text-sm font-semibold text-zinc-900 dark:text-zinc-100">Add reviewed profile</h3>
    <div class="grid gap-4 sm:grid-cols-2">
      <label class="text-sm text-zinc-700 dark:text-zinc-300">Name
        <%= text_field_tag "provider_profile[name]", nil, required: true, class: "mt-1 block w-full rounded-md border-zinc-300 dark:border-zinc-700 dark:bg-zinc-900" %>
      </label>
      <label class="text-sm text-zinc-700 dark:text-zinc-300">Approved catalog entry
        <%= select_tag "provider_profile[catalog_slug]",
          options_for_select(catalog_entries.map { |entry| [ "#{entry.provider} · #{entry.model}", entry.slug ] }),
          class: "mt-1 block w-full rounded-md border-zinc-300 dark:border-zinc-700 dark:bg-zinc-900" %>
      </label>
      <label class="text-sm text-zinc-700 dark:text-zinc-300">Tool-call limit
        <%= number_field_tag "provider_profile[tool_call_limit]", 8, min: 1, max: 8, required: true, class: "mt-1 block w-full rounded-md border-zinc-300 dark:border-zinc-700 dark:bg-zinc-900" %>
      </label>
      <label class="text-sm text-zinc-700 dark:text-zinc-300">Retention posture
        <%= select_tag "provider_profile[retention_posture]", options_for_select(Assistant::ProviderProfile::RETENTION_POSTURES), class: "mt-1 block w-full rounded-md border-zinc-300 dark:border-zinc-700 dark:bg-zinc-900" %>
      </label>
      <label class="text-sm text-zinc-700 dark:text-zinc-300">Reviewed at
        <%= datetime_local_field_tag "provider_profile[reviewed_at]", nil, required: true, class: "mt-1 block w-full rounded-md border-zinc-300 dark:border-zinc-700 dark:bg-zinc-900" %>
      </label>
      <label class="flex items-center gap-3 self-end pb-2 text-sm text-zinc-700 dark:text-zinc-300">
        <%= check_box_tag "provider_profile[enabled]", "1", false, class: "rounded border-zinc-300" %>
        Enable after creation
      </label>
    </div>
    <div><%= submit_tag "Create provider profile", class: "rounded-md bg-zinc-900 px-3 py-2 text-sm font-medium text-white dark:bg-zinc-100 dark:text-zinc-900" %></div>
  <% end %>
</section>
