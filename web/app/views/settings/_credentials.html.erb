<%= render layout: "settings/section", locals: { id: "credentials", title: "Platform credentials",
      subtitle: "API tokens (and where supported, session cookies) the Scope fetcher uses per platform." } do %>
  <div class="rounded-lg border border-amber-300 bg-amber-50 p-4 dark:border-amber-400/30 dark:bg-amber-500/10">
    <p class="text-sm font-medium text-amber-800 dark:text-amber-200">Not wired up yet — pending a storage decision.</p>
    <p class="mt-1 text-sm text-amber-700/90 dark:text-amber-200/80">
      These fields hold third-party bug-bounty API tokens. Hunter has no at-rest encryption configured, so
      before storing them we need to decide how: ActiveRecord <code class="rounded bg-amber-100 px-1 dark:bg-amber-500/20">encrypts</code>
      (recommended — encrypted columns, keys from ENV) or plaintext columns as Scope does (wire-protected only).
      The per-platform form below is a preview and does not submit.
    </p>
  </div>

  <div class="mt-4 grid gap-3 opacity-60 sm:grid-cols-2" aria-hidden="true">
    <% ScopePlatforms::ALL.each do |platform| %>
      <div class="rounded-lg border border-zinc-200 p-4 dark:border-zinc-800">
        <p class="text-sm font-medium text-zinc-800 dark:text-zinc-200"><%= platform.humanize %></p>
        <label class="mt-2 block text-xs font-medium text-zinc-500 dark:text-zinc-400">API token</label>
        <input type="password" disabled placeholder="•••••••• (not stored)"
               class="mt-1 w-full cursor-not-allowed rounded-md border border-zinc-300 bg-zinc-50 px-2.5 py-1.5 text-sm dark:border-zinc-700 dark:bg-zinc-900">
      </div>
    <% end %>
  </div>
<% end %>
