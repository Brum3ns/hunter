<%= render layout: "settings/section", locals: {
      id: "ansible-credentials", title: "Ansible credentials",
      subtitle: "Encrypted SSH identities used by the isolated Ansible executor. Saved secrets are never shown again."
    } do %>
  <%= form_with url: settings_ansible_credentials_path, scope: :ansible_credential,
                class: "grid gap-3 rounded-lg border border-zinc-200 p-4 dark:border-zinc-800" do |f| %>
    <div class="grid gap-3 sm:grid-cols-3">
      <div class="grid gap-1">
        <%= f.label :name, class: "text-xs font-medium text-zinc-600 dark:text-zinc-400" %>
        <%= f.text_field :name, required: true, placeholder: "worker-fleet-key",
              class: "rounded-md border border-zinc-300 bg-white px-2.5 py-1.5 text-sm dark:border-zinc-700 dark:bg-zinc-900" %>
      </div>
      <div class="grid gap-1">
        <%= f.label :auth_type, "Authentication", class: "text-xs font-medium text-zinc-600 dark:text-zinc-400" %>
        <%= f.select :auth_type,
              ControlCenter::Ansible::Credential::AUTH_TYPES.map { |value| [value.humanize, value] }, {},
              class: "rounded-md border border-zinc-300 bg-white px-2.5 py-1.5 text-sm dark:border-zinc-700 dark:bg-zinc-900" %>
      </div>
      <div class="grid gap-1">
        <%= f.label :username, class: "text-xs font-medium text-zinc-600 dark:text-zinc-400" %>
        <%= f.text_field :username, required: true, placeholder: "ansible", autocomplete: "username",
              class: "rounded-md border border-zinc-300 bg-white px-2.5 py-1.5 text-sm dark:border-zinc-700 dark:bg-zinc-900" %>
      </div>
    </div>
    <div class="grid gap-1">
      <%= f.label :private_key, class: "text-xs font-medium text-zinc-600 dark:text-zinc-400" %>
      <%= f.text_area :private_key, rows: 5, placeholder: "SSH private key (for private-key auth)", autocomplete: "off",
            class: "rounded-md border border-zinc-300 bg-white px-2.5 py-1.5 font-mono text-xs dark:border-zinc-700 dark:bg-zinc-900" %>
    </div>
    <div class="grid gap-3 sm:grid-cols-3">
      <div class="grid gap-1">
        <%= f.label :private_key_passphrase, "Key passphrase", class: "text-xs font-medium text-zinc-600 dark:text-zinc-400" %>
        <%= f.password_field :private_key_passphrase, autocomplete: "new-password",
              class: "rounded-md border border-zinc-300 bg-white px-2.5 py-1.5 text-sm dark:border-zinc-700 dark:bg-zinc-900" %>
      </div>
      <div class="grid gap-1">
        <%= f.label :ssh_password, class: "text-xs font-medium text-zinc-600 dark:text-zinc-400" %>
        <%= f.password_field :ssh_password, autocomplete: "new-password",
              class: "rounded-md border border-zinc-300 bg-white px-2.5 py-1.5 text-sm dark:border-zinc-700 dark:bg-zinc-900" %>
      </div>
      <div class="grid gap-1">
        <%= f.label :become_password, class: "text-xs font-medium text-zinc-600 dark:text-zinc-400" %>
        <%= f.password_field :become_password, autocomplete: "new-password",
              class: "rounded-md border border-zinc-300 bg-white px-2.5 py-1.5 text-sm dark:border-zinc-700 dark:bg-zinc-900" %>
      </div>
    </div>
    <%= f.submit "Save credential",
          class: "w-fit rounded-md bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200" %>
  <% end %>

  <div class="mt-4 space-y-3">
    <% credentials.each do |credential| %>
      <article class="rounded-lg border border-zinc-200 p-3 dark:border-zinc-800">
        <div class="flex items-center gap-3 text-sm">
          <div class="min-w-0 flex-1">
            <p class="font-medium text-zinc-900 dark:text-zinc-100"><%= credential.name %></p>
            <p class="truncate text-xs text-zinc-500 dark:text-zinc-400">
              <%= credential.username %> · <%= credential.auth_type.humanize %> ·
              <%= credential.public_key_fingerprint || "password configured" %>
            </p>
          </div>
          <%= button_to "Delete", settings_ansible_credential_path(credential), method: :delete,
                class: "text-xs font-medium text-rose-600 hover:text-rose-500 dark:text-rose-400",
                form: { data: { turbo_confirm: "Delete #{credential.name}?" } } %>
        </div>

        <details class="mt-3 border-t border-zinc-200 pt-3 dark:border-zinc-800">
          <summary class="cursor-pointer text-sm font-medium text-zinc-700 dark:text-zinc-300">Edit <%= credential.name %></summary>
          <%= form_with url: settings_ansible_credential_path(credential), method: :patch,
                        scope: :ansible_credential, namespace: "ansible_credential_#{credential.id}",
                        class: "mt-3 grid gap-3" do |f| %>
            <div class="grid gap-3 sm:grid-cols-3">
              <%= f.text_field :name, value: credential.name, required: true, aria: { label: "Name" },
                    class: "rounded-md border border-zinc-300 bg-white px-2.5 py-1.5 text-sm dark:border-zinc-700 dark:bg-zinc-900" %>
              <%= f.select :auth_type,
                    ControlCenter::Ansible::Credential::AUTH_TYPES.map { |value| [value.humanize, value] },
                    { selected: credential.auth_type }, aria: { label: "Authentication" },
                    class: "rounded-md border border-zinc-300 bg-white px-2.5 py-1.5 text-sm dark:border-zinc-700 dark:bg-zinc-900" %>
              <%= f.text_field :username, value: credential.username, required: true, autocomplete: "username",
                    aria: { label: "Username" },
                    class: "rounded-md border border-zinc-300 bg-white px-2.5 py-1.5 text-sm dark:border-zinc-700 dark:bg-zinc-900" %>
            </div>
            <% ControlCenter::Ansible::Credential::SECRET_FIELDS.each do |field| %>
              <div class="grid gap-2 sm:grid-cols-[1fr_auto] sm:items-center">
                <% placeholder = credential.public_send("#{field}_configured?") ? "Configured — leave blank to retain" : "Not configured" %>
                <% if field == :private_key %>
                  <%= f.text_area field, value: nil, rows: 4, placeholder: placeholder, autocomplete: "off",
                        aria: { label: field.to_s.humanize },
                        class: "rounded-md border border-zinc-300 bg-white px-2.5 py-1.5 font-mono text-xs dark:border-zinc-700 dark:bg-zinc-900" %>
                <% else %>
                  <%= f.password_field field, value: nil, placeholder: placeholder, autocomplete: "new-password",
                        aria: { label: field.to_s.humanize },
                        class: "rounded-md border border-zinc-300 bg-white px-2.5 py-1.5 text-sm dark:border-zinc-700 dark:bg-zinc-900" %>
                <% end %>
                <label class="flex items-center gap-2 text-xs text-zinc-600 dark:text-zinc-400">
                  <%= f.check_box "clear_#{field}" %> Clear saved <%= field.to_s.humanize.downcase %>
                </label>
              </div>
            <% end %>
            <%= f.submit "Update credential",
                  class: "w-fit rounded-md bg-zinc-900 px-3 py-1.5 text-sm font-medium text-white hover:bg-zinc-700 dark:bg-white dark:text-zinc-900 dark:hover:bg-zinc-200" %>
          <% end %>
        </details>
      </article>
    <% end %>
    <% if credentials.empty? %>
      <p class="text-sm text-zinc-500 dark:text-zinc-400">No Ansible credentials configured.</p>
    <% end %>
  </div>
<% end %>
