<% content_for :title, "hunter — Dashboard" %>

<header class="border-b border-zinc-800">
  <div class="mx-auto flex max-w-6xl items-center justify-between px-6 py-4">
    <div class="flex items-center gap-2">
      <span class="text-lg font-bold tracking-tight text-zinc-100">hunter</span>
      <span class="rounded bg-indigo-600/20 px-1.5 py-0.5 text-xs font-medium text-indigo-400">beta</span>
    </div>
    <div class="flex items-center gap-4 text-sm">
      <span class="text-zinc-400"><%= Current.user&.username %></span>
      <%= button_to "Sign out", session_path, method: :delete,
            class: "rounded-md border border-zinc-700 px-3 py-1.5 text-zinc-300 hover:bg-zinc-900" %>
    </div>
  </div>
</header>

<main class="mx-auto max-w-6xl px-6 py-12">
  <h1 class="text-2xl font-semibold text-zinc-100">Dashboard</h1>
  <p class="mt-2 text-zinc-400">
    Welcome to hunter. Vulnerability management features are coming next.
  </p>

  <div class="mt-8 rounded-lg border border-zinc-800 bg-zinc-900/40 p-6">
    <p class="text-sm text-zinc-500">
      You are signed in. PostgreSQL, Rails, and Tailwind are wired up. The
      MongoDB-backed vulnerability API will be added in a later pass.
    </p>
  </div>
</main>
