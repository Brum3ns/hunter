<div class="min-h-screen flex items-center justify-center px-4">
  <div class="w-full max-w-sm">
    <div class="mb-8 text-center">
      <h1 class="flex items-center justify-center gap-2 text-3xl font-bold tracking-tight text-zinc-900 dark:text-zinc-100">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="h-7 w-7" aria-hidden="true">
          <circle cx="12" cy="12" r="9" stroke="currentColor" stroke-width="1.5"></circle>
          <path d="M15.5 8.5a5 5 0 10-1 7.8" stroke="currentColor" stroke-width="1.5" stroke-linecap="round"></path>
        </svg>hunter
      </h1>
      <p class="mt-1 text-sm text-zinc-500 dark:text-zinc-400">Vulnerability management</p>
    </div>

    <% if alert = flash[:alert] %>
      <p class="mb-4 rounded-lg border border-red-300 bg-red-50 px-3 py-2 text-sm text-red-700 dark:border-red-900/50 dark:bg-red-950/50 dark:text-red-400" id="alert"><%= alert %></p>
    <% end %>

    <% if notice = flash[:notice] %>
      <p class="mb-4 rounded-lg border border-zinc-300 bg-zinc-100 px-3 py-2 text-sm text-zinc-700 dark:border-zinc-700 dark:bg-zinc-900 dark:text-zinc-300" id="notice"><%= notice %></p>
    <% end %>

    <%= form_with url: session_url, class: "space-y-4" do |form| %>
      <div>
        <%= form.label :username, class: "block text-sm font-medium text-zinc-600 mb-1 dark:text-zinc-400" %>
        <%= form.text_field :username, required: true, autofocus: true, autocomplete: "username", placeholder: "admin", value: params[:username],
              class: "block w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-zinc-900 placeholder-zinc-400 focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-[#111315] dark:text-zinc-100 dark:placeholder-zinc-600 dark:focus:border-white dark:focus:ring-white" %>
      </div>

      <div>
        <%= form.label :password, class: "block text-sm font-medium text-zinc-600 mb-1 dark:text-zinc-400" %>
        <%= form.password_field :password, required: true, autocomplete: "current-password", placeholder: "••••••••", maxlength: 72,
              class: "block w-full rounded-md border border-zinc-300 bg-white px-3 py-2 text-zinc-900 placeholder-zinc-400 focus:border-zinc-900 focus:outline-none focus:ring-1 focus:ring-zinc-900 dark:border-zinc-700 dark:bg-[#111315] dark:text-zinc-100 dark:placeholder-zinc-600 dark:focus:border-white dark:focus:ring-white" %>
      </div>

      <%= form.submit "Sign in",
            class: "w-full cursor-pointer rounded-md bg-zinc-900 px-3.5 py-2.5 text-center font-medium text-white hover:bg-zinc-700 focus:outline-none focus:ring-2 focus:ring-zinc-900 focus:ring-offset-2 dark:bg-white dark:text-zinc-950 dark:hover:bg-zinc-200 dark:focus:ring-white dark:focus:ring-offset-[#0a0a0a]" %>
    <% end %>
  </div>
</div>
