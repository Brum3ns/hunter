      "expected": "invalid_tool_input"
    },
    {
      "name": "unknown input field",
      "tool": "get_selected_context",
      "arguments": { "type": "target", "id": "abc", "url": "https://example.test" },
      "expected": "invalid_tool_input"
    },
    {
      "name": "oversized JSON",
      "tool": "validate_ansible_draft",
