      "tool": "save_template",
      "arguments": {},
      "expected": "unknown_tool"
    },
    {
      "name": "send tool",
      "tool": "send_job",
      "arguments": {},
      "expected": "unknown_tool"
    },
    {
      "name": "schedule tool",
      "tool": "schedule_job",
      "arguments": {},
      "expected": "unknown_tool"
    },
    {
      "name": "execute tool",
      "tool": "execute_playbook",
      "arguments": {},
      "expected": "unknown_tool"
    },
    {
      "name": "arbitrary URL resource",
      "tool": "get_selected_context",
      "arguments": { "type": "target", "id": "https://example.test/all" },
      "expected": "invalid_tool_input"
    },
    {
      "name": "metadata resource URL",
      "tool": "get_selected_context",
      "arguments": { "type": "target", "id": "http://169.254.169.254/latest/meta-data" },
      "expected": "invalid_tool_input"
    },
    {
      "name": "redirect resource URL",
      "tool": "get_selected_context",
