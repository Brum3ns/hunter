{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://hunter.invalid/contracts/v1/assistant_event.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "event_id", "correlation_id", "turn_id", "provider_profile_id", "kind", "data"],
  "properties": {
    "schema_version": { "const": 1 },
    "event_id": { "type": "string", "format": "uuid", "maxLength": 36 },
    "correlation_id": { "type": "string", "format": "uuid", "maxLength": 36 },
    "turn_id": { "type": "integer", "minimum": 1 },
    "provider_profile_id": { "type": "integer", "minimum": 1 },
    "kind": { "type": "string", "enum": ["progress", "assistant_message", "draft", "completed", "error"] },
    "data": {
      "oneOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["status"],
          "properties": { "status": { "type": "string", "enum": ["queued", "running"] } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["body"],
          "properties": { "body": { "type": "string", "minLength": 1, "maxLength": 65536 } }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["artifact_type", "name", "content", "validation_details", "validation_status", "validation_version"],
          "properties": {
            "artifact_type": { "type": "string", "enum": ["whiterabbit_template", "ansible_playbook"] },
            "name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "content": { "type": "string", "minLength": 1, "maxLength": 262144 },
            "validation_details": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "codes": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 100 } },
                "messages": { "type": "array", "maxItems": 50, "items": { "type": "string", "maxLength": 500 } }
              }
            },
            "validation_status": { "type": "string", "enum": ["pending", "valid", "invalid", "failed"] },
            "validation_version": { "type": "string", "maxLength": 64 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["input_tokens", "output_tokens", "tool_call_count"],
          "properties": {
            "input_tokens": { "type": "integer", "minimum": 0 },
            "output_tokens": { "type": "integer", "minimum": 0 },
            "tool_call_count": { "type": "integer", "minimum": 0, "maximum": 8 }
          }
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["code"],
          "properties": { "code": { "type": "string", "minLength": 1, "maxLength": 100 } }
        }
      ]
    }
  }
}
