                    "maxLength": 255
                  },
                  "operator": {
                    "type": "string",
                    "enum": [
                      "",
                      "|",
                      "\u0026\u0026",
                      "||"
                    ]
                  },
                  "args": {
                    "type": "array",
                    "maxItems": 200,
                    "items": {
                      "type": "string",
                      "maxLength": 4096
                    }
                  }
                }
              }
            },
            "target": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "type": {
                  "type": "string",
                  "maxLength": 100
                },
                "separator": {
                  "type": "string",
                  "maxLength": 20
                },
                "output": {
                  "type": "string",
                  "maxLength": 4000
                }
              }
            }
          }
        }
