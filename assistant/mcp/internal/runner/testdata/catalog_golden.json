  {
    "name": "list_cves",
    "description": "List and count tracked CVEs, optionally filtered by ecosystem, package, severity, or fix status.",
    "input_schema": {
      "additionalProperties": false,
      "properties": {
        "cwe": {
          "description": "CWE id, e.g. CWE-79.",
          "maxLength": 40,
          "type": "string"
        },
        "ecosystem": {
          "description": "Package ecosystem, e.g. npm, PyPI, Go.",
          "maxLength": 100,
          "type": "string"
        },
        "has_fix": {
          "description": "Whether a fix is available: pass true or false.",
          "maxLength": 5,
          "type": "string"
        },
        "language": {
          "description": "Affected language.",
          "maxLength": 100,
          "type": "string"
        },
        "limit": {
          "description": "Max items per page (default and max 50).",
          "maximum": 50,
          "minimum": 1,
          "type": "integer"
        },
        "min_severity": {
          "description": "Minimum severity: critical, high, medium, or low.",
          "maxLength": 10,
          "type": "string"
        },
        "modified_after": {
          "description": "ISO-8601 datetime, e.g. 2024-01-01T00:00:00Z (a bare date is rejected); only CVEs modified on/after it.",
          "maxLength": 40,
          "type": "string"
        },
        "package": {
          "description": "Affected package name.",
          "maxLength": 200,
          "type": "string"
        },
        "page": {
          "description": "1-based page number (default 1).",
          "maximum": 100000,
          "minimum": 1,
          "type": "integer"
        },
        "published_after": {
          "description": "ISO-8601 datetime, e.g. 2024-01-01T00:00:00Z (a bare date is rejected); only CVEs published on/after it.",
          "maxLength": 40,
          "type": "string"
        },
        "q": {
          "description": "Plain case-insensitive substring search over CVE id, summary, and details. Not a dork — use the typed filters for precise matches.",
          "maxLength": 200,
          "type": "string"
        },
        "tag": {
          "description": "Filter by tag.",
          "maxLength": 100,
          "type": "string"
        },
        "vendor": {
          "description": "Affected vendor.",
          "maxLength": 100,
          "type": "string"
        }
      },
      "type": "object"
    },
    "output_schema": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "result"
      ],
      "properties": {
        "result": {
          "type": "object"
        }
      }
    }
  },
