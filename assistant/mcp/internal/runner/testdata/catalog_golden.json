          "type": "object",
          "additionalProperties": false,
          "required": [
            "correlation_id",
            "template"
          ],
          "properties": {
            "correlation_id": {
              "type": "string",
              "format": "uuid"
            },
            "template": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "name",
                "lock_version"
              ],
              "properties": {
                "id": {
                  "type": "integer",
                  "minimum": 1
                },
                "name": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 200
                },
                "lock_version": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            }
          }
        }
      }
    }
  },
