#include <tunables/global>

profile hunter-assistant-validator flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network unix stream,
  network unix dgram,
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  deny network raw,
  deny mount,
  deny umount,
  deny ptrace,

  /dev/init rix,
  /hunter-assistant-validator rix,
  /usr/bin/ansible-playbook rix,
  /usr/bin/python3* rix,
  /usr/lib/** mr,
  /usr/share/ansible/** r,
  /usr/share/python*/** r,
  /lib/** mr,
  /etc/ansible/** r,
  /etc/hosts r,
  /etc/hostname r,
  /etc/resolv.conf r,
  /etc/nsswitch.conf r,
  /etc/ssl/certs/** r,
  /run/secrets/assistant_validator_amqp_password r,
  /proc/sys/net/core/somaxconn r,
  /proc/sys/net/ipv4/ip_local_port_range r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,
  /tmp/ rw,
  /tmp/** rw,
  /work/ rw,
  /work/** rw,
}
