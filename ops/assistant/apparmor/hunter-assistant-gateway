# NOT applied by default. Compose no longer references this profile (the
# `apparmor=hunter-assistant-gateway` security_opt line was removed from both
# docker-compose.yaml and docker-compose.prod.yaml on 2026-07-26 — see
# docs/superpowers/specs/2026-07-26-hunter-assistant-zero-step-activation-delta.md).
# Enabling it requires loading it into the host kernel as root before
# `docker compose up` (`apparmor_parser -r ops/assistant/apparmor/hunter-assistant-gateway`)
# and re-adding the security_opt line; without that, Docker's built-in
# `docker-default` AppArmor profile applies to this container instead, layered
# over its seccomp profile, read_only root, dropped capabilities, and non-root
# user as before.
#include <tunables/global>

profile hunter-assistant-gateway flags=(attach_disconnected,mediate_deleted) {
  #include <abstractions/base>

  network unix stream,
  network unix dgram,
  network inet stream,
  network inet dgram,
  network inet6 stream,
  network inet6 dgram,
  deny network raw,
  deny mount,
  deny umount,
  deny ptrace,

  /dev/init rix,
  /hunter-assistant-gateway rix,
  /etc/hosts r,
  /etc/hostname r,
  /etc/resolv.conf r,
  /etc/nsswitch.conf r,
  /etc/ssl/certs/** r,
  /proc/sys/net/core/somaxconn r,
  /proc/sys/net/ipv4/ip_local_port_range r,
  /sys/kernel/mm/transparent_hugepage/hpage_pmd_size r,
  /tmp/ rw,
  /tmp/** rw,
}
