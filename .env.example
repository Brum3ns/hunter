# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# PostgreSQL (users, sessions, API tokens, config)
DB_HOST=db
DB_PORT=5432
DB_DATABASE=hunter_development
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Active Record application-level encryption. Generate with:
#   cd web && bin/rails db:encryption:init
# Never reuse the development defaults in production.
ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Seeded admin account for the web UI (created by db:seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# MongoDB (vulnerability findings and future module data). Leave username/password
# blank for an unauthenticated local Mongo; auth_source/timeouts only matter when
# pointing at an authenticated or remote Mongo.
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE=bugbounty
MONGO_COLLECTION=vulnerabilities
# Programs module collection (the Scope CLI writes programs into "scope").
MONGO_PROGRAMS_COLLECTION=scope
MONGO_USERNAME=
MONGO_PASSWORD=
MONGO_AUTH_SOURCE=admin
MONGO_SERVER_SELECTION_TIMEOUT=3
MONGO_CONNECT_TIMEOUT=3

# Runner (isolated curl execution)
# Set RUNNER_TOKEN to any strong secret (>= 32 chars) shared by the web app and
# the runner container: db:seed registers a matching runner automatically, so
# there is no mint-copy-restart step. Generate one with `openssl rand -base64 32`.
# Leave it blank to disable the runner. A value shorter than 32 chars fails the
# seed on purpose. RUNNER_NAME/RUNNER_KINDS control the seeded runner's identity.
RUNNER_TOKEN=
RUNNER_NAME=default
RUNNER_KINDS=curl
RUNNER_POLL_INTERVAL=2
# Max curl jobs executed at once by one runner. curl runs are network-bound, so
# a pool lets independent jobs overlap instead of waiting behind one slow
# request. Raise mem_limit/pids_limit in docker-compose.yaml if you increase it.
RUNNER_MAX_CONCURRENCY=30
CURL_MAX_TIME=30
CURL_MAX_OUTPUT=262144
RUNNER_JOB_TTL=90

# Ansible executor (isolated pull-based execution)
# Create a Runner with the `ansible` capability in Settings, copy its one-time
# token here, and start development with `docker compose --profile ansible up`.
# Production must provide a non-empty token and at least one VPN CIDR; the
# executor rejects startup when either value is missing.
HUNTER_ANSIBLE_RUNNER_TOKEN=
HUNTER_ANSIBLE_URL=http://web:5000
ANSIBLE_ALLOWED_CIDRS=
ANSIBLE_ALLOWED_PORTS=22
ANSIBLE_POLL_SECONDS=2
ANSIBLE_HEARTBEAT_SECONDS=15
ANSIBLE_LEASE_SECONDS=45
ANSIBLE_CLAIM_TIMEOUT_SECONDS=300
ANSIBLE_MAX_EVENT_BATCH=100
ANSIBLE_MAX_BUFFER_BYTES=5242880
ANSIBLE_CANCEL_GRACE_SECONDS=10
ANSIBLE_MAX_FORKS=5

# Control Center / Whiterabbit
WHITERABBIT_BIN=/usr/local/bin/whiterabbit
# Whiterabbit's own RabbitMQ broker (Control Center). This is NOT used by the
# Assistant, which talks to its gateway over HTTP and needs no broker. The
# defaults match the rabbitmq service in docker-compose.yaml.
RABBITMQ_HOST=rabbitmq
RABBITMQ_PORT=5672
RABBITMQ_HTTP_PORT=15672
RABBITMQ_USERNAME=hunter
RABBITMQ_PASSWORD=hunter
RABBITMQ_TOKEN=
CMDSCRIPT_HASH_SALT=
# Comma-separated allowlist of binaries templates may invoke.
# WARNING empty means ANY binary is permitted. The Assistant treats an empty value
# as a misconfiguration and stays disabled (reason: missing_command_allowlist), so
# set it explicitly. `curl` matches the default RUNNER_KINDS and `httpx`
# supports the Assistant's one-turn target-proof template workflow.
CONTROL_CENTER_COMMAND_ALLOWLIST=curl,httpx

# Assistant (LLM chat). Every secret below is a plain environment variable —
# there is no file mount, no broker, and no bootstrap step. `docker compose up`
# brings the Assistant up ready-to-go once these are set.
#
# The default Assistant chat now runs through the Claude Code service
# (assistant-claude, below) on your Claude subscription — it needs NO provider
# API key. The two keys below drive ONLY the retired provider-gateway path,
# which sits behind the `legacy-gateway` Compose profile and does not start on a
# default `up`. Leave them blank unless you deliberately run that legacy path;
# never put a real key in this file — set it in your own untracked .env.
ASSISTANT_ANTHROPIC_API_KEY=
ASSISTANT_OPENAI_API_KEY=

# Assistant machine credentials — bearer tokens the internal HTTP services use
# to authenticate each other. Generate each with `openssl rand -base64 32` and
# keep them distinct. Leave blank in a checked-out .env.example; a blank value
# here is intentional (never a real secret), but a deployed stack needs all
# four set or the gateway/validator/hunter-mcp refuse to boot.
ASSISTANT_GATEWAY_MCP_TOKEN=
ASSISTANT_MCP_HUNTER_TOKEN=
ASSISTANT_GATEWAY_INGRESS_TOKEN=
ASSISTANT_VALIDATOR_INGRESS_TOKEN=

# Where Rails reaches the gateway/validator over plain HTTP inside the compose
# network. Override only if you renamed a service or port.
ASSISTANT_GATEWAY_URL=http://assistant-gateway:8081
ASSISTANT_VALIDATOR_URL=http://assistant-validator:8082

# Where Rails reaches the Claude Code wrapper over plain HTTP inside the
# compose network. Override only if you renamed the service or port.
ASSISTANT_CLAUDE_URL=http://assistant-claude:8083
# Bearer token guarding Rails -> assistant-claude requests. UNLIKE the other
# ingress tokens, this one is OPTIONAL: leave it blank and the service disables
# the bearer check entirely, trusting the internal-only assistant-rails-claude
# network (the service publishes no host port and only web can reach it). This
# is the intended single-user / local-dev posture, and the service logs a loud
# WARNING at startup when auth is disabled. Set a matching value on both web and
# assistant-claude to require the credential (defense-in-depth).
ASSISTANT_CLAUDE_INGRESS_TOKEN=

# Comma-separated Ansible modules the Assistant may propose in a draft. Empty
# leaves the Assistant disabled (reason: missing_ansible_module_allowlist).
# ansible.builtin.debug is inert; widen deliberately.
ASSISTANT_ANSIBLE_MODULE_ALLOWLIST=ansible.builtin.debug
ASSISTANT_TRANSCRIPT_DAYS=7
ASSISTANT_AUDIT_DAYS=90
ASSISTANT_GRANT_TTL_SECONDS=300
ASSISTANT_MAX_RECORDS=10
ASSISTANT_MAX_TOOL_CALLS=8
ASSISTANT_MAX_RESULT_BYTES=65536
ASSISTANT_MAX_TOTAL_BYTES=262144
ASSISTANT_TURN_STARTS_PER_MINUTE=10
ASSISTANT_TURN_STARTS_PER_HOUR=60
ASSISTANT_MAX_CONCURRENT_TURNS=2
ASSISTANT_MAX_VALIDATIONS_PER_TURN=1
# Production Compose may select an immutable CI commit tag here. Image digests
# are recorded and pinned during the Task 18 production review.
ASSISTANT_IMAGE_TAG=latest
