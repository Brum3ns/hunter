# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# PostgreSQL (users, settings, config)
DB_USERNAME=postgres
DB_PASSWORD=postgres

# Seeded admin account for the web UI (created by db:seed)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin

# MongoDB (vulnerability results) — not consumed by Rails yet, reserved for the
# upcoming vulnerability API. Leave username/password blank for an unauthenticated
# local Mongo.
MONGO_HOST=mongo
MONGO_PORT=27017
MONGO_DATABASE=hunter
MONGO_COLLECTION=vulnerabilities
MONGO_USERNAME=
MONGO_PASSWORD=
