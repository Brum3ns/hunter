# Copy this file to .env and adjust as needed:
#   cp .env.example .env

# PostgreSQL (users, sessions, API tokens, config)
HUNTER_DB_HOST=db
HUNTER_DB_PORT=5432
HUNTER_DB_DATABASE=hunter_development
HUNTER_DB_USERNAME=postgres
HUNTER_DB_PASSWORD=postgres

# Active Record application-level encryption. Generate with:
#   cd web && bin/rails db:encryption:init
# Never reuse the development defaults in production.
HUNTER_ACTIVE_RECORD_ENCRYPTION_PRIMARY_KEY=
HUNTER_ACTIVE_RECORD_ENCRYPTION_DETERMINISTIC_KEY=
HUNTER_ACTIVE_RECORD_ENCRYPTION_KEY_DERIVATION_SALT=

# Seeded admin account for the web UI (created by db:seed)
HUNTER_ADMIN_USERNAME=admin
HUNTER_ADMIN_PASSWORD=admin

# MongoDB (vulnerability findings and future module data). Leave username/password
# blank for an unauthenticated local Mongo; auth_source/timeouts only matter when
# pointing at an authenticated or remote Mongo.
HUNTER_MONGO_HOST=mongo
HUNTER_MONGO_PORT=27017
HUNTER_MONGO_DATABASE=bugbounty
HUNTER_MONGO_COLLECTION=vulnerabilities
# Programs module collection (the Scope CLI writes programs into "scope").
HUNTER_MONGO_PROGRAMS_COLLECTION=scope
HUNTER_MONGO_USERNAME=
HUNTER_MONGO_PASSWORD=
HUNTER_MONGO_AUTH_SOURCE=admin
HUNTER_MONGO_SERVER_SELECTION_TIMEOUT=3
HUNTER_MONGO_CONNECT_TIMEOUT=3

# Runner (isolated curl execution)
# Set HUNTER_RUNNER_TOKEN to any strong secret (>= 32 chars) shared by the web app and
# the runner container: db:seed registers a matching runner automatically, so
# there is no mint-copy-restart step. Generate one with `openssl rand -base64 32`.
# Leave it blank to disable the runner. A value shorter than 32 chars fails the
# seed on purpose. HUNTER_RUNNER_NAME/HUNTER_RUNNER_KINDS control the seeded runner's identity.
HUNTER_RUNNER_TOKEN=
HUNTER_RUNNER_NAME=default
HUNTER_RUNNER_KINDS=curl
HUNTER_RUNNER_POLL_INTERVAL=2
# Max curl jobs executed at once by one runner. curl runs are network-bound, so
# a pool lets independent jobs overlap instead of waiting behind one slow
# request. Raise mem_limit/pids_limit in docker-compose.yaml if you increase it.
HUNTER_RUNNER_MAX_CONCURRENCY=30
HUNTER_CURL_MAX_TIME=30
HUNTER_CURL_MAX_OUTPUT=262144
HUNTER_RUNNER_JOB_TTL=90

# Ansible executor (isolated pull-based execution)
# Create a Runner with the `ansible` capability in Settings, copy its one-time
# token here, and start development with `docker compose --profile ansible up`.
# Production must provide a non-empty token and at least one VPN CIDR; the
# executor rejects startup when either value is missing.
HUNTER_ANSIBLE_RUNNER_TOKEN=
HUNTER_ANSIBLE_URL=http://web:5000
HUNTER_ANSIBLE_ALLOWED_CIDRS=
HUNTER_ANSIBLE_ALLOWED_PORTS=22
HUNTER_ANSIBLE_POLL_SECONDS=2
HUNTER_ANSIBLE_HEARTBEAT_SECONDS=15
HUNTER_ANSIBLE_LEASE_SECONDS=45
HUNTER_ANSIBLE_CLAIM_TIMEOUT_SECONDS=300
HUNTER_ANSIBLE_MAX_EVENT_BATCH=100
HUNTER_ANSIBLE_MAX_BUFFER_BYTES=5242880
HUNTER_ANSIBLE_CANCEL_GRACE_SECONDS=10
HUNTER_ANSIBLE_MAX_FORKS=5

# Control Center / Whiterabbit
HUNTER_WHITERABBIT_BIN=/usr/local/bin/whiterabbit
# Whiterabbit's own RabbitMQ broker (Control Center). This is NOT used by the
# Assistant, which talks to its gateway over HTTP and needs no broker. The
# defaults match the rabbitmq service in docker-compose.yaml.
HUNTER_RABBITMQ_HOST=rabbitmq
HUNTER_RABBITMQ_PORT=5672
HUNTER_RABBITMQ_HTTP_PORT=15672
HUNTER_RABBITMQ_USERNAME=hunter
HUNTER_RABBITMQ_PASSWORD=hunter
HUNTER_RABBITMQ_TOKEN=
HUNTER_CMDSCRIPT_HASH_SALT=

# Assistant (LLM chat). Every secret below is a plain environment variable —
# there is no file mount, no broker, and no bootstrap step. `docker compose up`
# brings the Assistant up ready-to-go once these are set.
#
# Direct Assistant chat runs through Claude Code or Codex on your matching
# subscription — neither service accepts a provider API key. The two keys below
# drive ONLY the retired provider-gateway path,
# which sits behind the `legacy-gateway` Compose profile and does not start on a
# default `up`. Leave them blank unless you deliberately run that legacy path;
# never put a real key in this file — set it in your own untracked .env.
HUNTER_ASSISTANT_ANTHROPIC_API_KEY=
HUNTER_ASSISTANT_OPENAI_API_KEY=

# Assistant machine credentials — bearer tokens the internal HTTP services use
# to authenticate each other. Generate each with `openssl rand -base64 32` and
# keep them distinct. Leave blank in a checked-out .env.example; a blank value
# here is intentional (never a real secret), but a deployed stack needs all
# four set or the gateway/validator/hunter-mcp refuse to boot.
HUNTER_ASSISTANT_GATEWAY_MCP_TOKEN=
HUNTER_ASSISTANT_MCP_HUNTER_TOKEN=
HUNTER_ASSISTANT_GATEWAY_INGRESS_TOKEN=
HUNTER_ASSISTANT_VALIDATOR_INGRESS_TOKEN=

# Where Rails reaches the gateway/validator over plain HTTP inside the compose
# network. Override only if you renamed a service or port.
HUNTER_ASSISTANT_GATEWAY_URL=http://assistant-gateway:8081
HUNTER_ASSISTANT_VALIDATOR_URL=http://assistant-validator:8082

# Where Rails reaches the Claude Code wrapper over plain HTTP inside the
# compose network. Override only if you renamed the service or port.
HUNTER_ASSISTANT_CLAUDE_URL=http://assistant-claude:8083
# Bearer token guarding Rails -> assistant-claude requests. UNLIKE the other
# ingress tokens, this one is OPTIONAL: leave it blank and the service disables
# the bearer check entirely, trusting the internal-only assistant-rails-claude
# network (the service publishes no host port and only web can reach it). This
# is the intended single-user / local-dev posture, and the service logs a loud
# WARNING at startup when auth is disabled. Set a matching value on both web and
# assistant-claude to require the credential (defense-in-depth).
HUNTER_ASSISTANT_CLAUDE_INGRESS_TOKEN=

# Where Rails reaches the Codex wrapper over its dedicated internal network.
# Codex uses ChatGPT login only; authenticate the assistant_codex_home volume
# with the pinned CLI's login flow. Never add OPENAI_API_KEY or CODEX_API_KEY.
HUNTER_ASSISTANT_CODEX_URL=http://assistant-codex:8084
# Required bearer guarding Rails -> assistant-codex requests. Generate it with
# `openssl rand -base64 32`; it must remain distinct from the Claude bearer.
HUNTER_ASSISTANT_CODEX_INGRESS_TOKEN=

# Comma-separated Ansible modules the Assistant may propose in a draft. Empty
# leaves the Assistant disabled (reason: missing_ansible_module_allowlist).
# ansible.builtin.debug is inert; widen deliberately.
HUNTER_ASSISTANT_ANSIBLE_MODULE_ALLOWLIST=ansible.builtin.debug
HUNTER_ASSISTANT_TRANSCRIPT_DAYS=7
HUNTER_ASSISTANT_AUDIT_DAYS=90
HUNTER_ASSISTANT_GRANT_TTL_SECONDS=1800
HUNTER_ASSISTANT_MAX_RECORDS=10
HUNTER_ASSISTANT_MAX_TOOL_CALLS=64
HUNTER_ASSISTANT_MAX_RESULT_BYTES=1048576
HUNTER_ASSISTANT_MAX_TOTAL_BYTES=16777216
HUNTER_ASSISTANT_MAX_EFFECTS_PER_TURN=32
HUNTER_ASSISTANT_MAX_EFFECTS_PER_HOUR=120
HUNTER_ASSISTANT_MAX_LAUNCHES_PER_TURN=16
HUNTER_ASSISTANT_MAX_LAUNCHES_PER_HOUR=60
HUNTER_ASSISTANT_TURN_STARTS_PER_MINUTE=10
HUNTER_ASSISTANT_TURN_STARTS_PER_HOUR=60
HUNTER_ASSISTANT_MAX_CONCURRENT_TURNS=2
HUNTER_ASSISTANT_MAX_VALIDATIONS_PER_TURN=1
HUNTER_ASSISTANT_MAX_CREATES_PER_MINUTE=5
HUNTER_ASSISTANT_MAX_CREATES_PER_HOUR=30
# Production Compose may select an immutable CI commit tag here. Image digests
# are recorded and pinned during the Task 18 production review.
HUNTER_ASSISTANT_IMAGE_TAG=latest
